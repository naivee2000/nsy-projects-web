  "version": 1,
  "status": "approved",
  "title": "Most Frequent Values",
  "summary": "Return the k values occurring most often.",
  "statement": "Return the `k` most frequent distinct values. Test data never ties across the selection boundary; result order does not matter.",
  "constraints": [
    "1 <= k <= number of distinct values",
    "Boundary frequencies are unique."
  ],
  "topics": [
    "heaps",
    "hash-maps",
    "buckets"
  ],
  "prerequisites": [
    "hash-maps"
  ],
  "signature": {
    "name": "top_k_frequent",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "k",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[int]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def top_k_frequent(nums: list[int], k: int) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def top_k_frequent(nums, k):\n    buckets = [[] for _ in range(len(nums) + 1)]\n    for value, frequency in Counter(nums).items():\n        buckets[frequency].append(value)\n    result = []\n    for frequency in range(len(buckets) - 1, 0, -1):\n        result.extend(buckets[frequency])\n        if len(result) >= k:\n            return result[:k]\n    return result\n",
  "brute_force_solution": "def top_k_frequent(nums, k):\n    buckets = [[] for _ in range(len(nums) + 1)]\n    for value, frequency in Counter(nums).items():\n        buckets[frequency].append(value)\n    result = []\n    for frequency in range(len(buckets) - 1, 0, -1):\n        result.extend(buckets[frequency])\n        if len(result) >= k:\n            return result[:k]\n    return result\n",
  "known_wrong_solutions": [
    "def top_k_frequent(nums, k):\n    return None\n",
    "def top_k_frequent(nums, k):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(n)",
  "estimated_minutes": 30,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "First count every distinct value.",
    "A frequency cannot exceed len(nums), so frequencies can index buckets.",
    "Place values into frequency buckets and read buckets from high to low.",
    "Bucket counting avoids sorting all distinct values."
  ],
  "editorial": "Count values, bucket them by frequency, then traverse buckets from most frequent until k values are collected.",
