  "title": "Longest Uncommon Subsequence II",
  "summary": "Given an array of strings, determine the length of the longest string that is a subsequence of one string in the array but not of the others.",
  "statement": "Given an array of strings, determine the length of the longest string that is a subsequence of one string in the array but not of the others. If no such subsequence exists, return -1. A subsequence is formed by deleting any number of characters from the original string.",
  "constraints": [
    "2 <= len(strs) <= 50; lowercase English letters only.",
    "Source 522 uses 1..10 characters per word. This app explicitly supports 1 <= len(word) <= 100 to include the two-string source 521 domain in the same exercise.",
    "An uncommon subsequence belongs to exactly ONE input position and to none of the other input strings. Duplicate strings at different positions count separately.",
    "You may delete characters but cannot reorder them. Return the maximum length, or -1 if none exists."
  ],
  "topics": [
    "strings",
    "two-pointers"
  ],
  "prerequisites": [],
