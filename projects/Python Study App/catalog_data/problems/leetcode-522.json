  "starter_code": "def longest_uncommon_subsequence(strs: list[str]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def longest_uncommon_subsequence(strs):\n    def contained(word,text):\n        index=0\n        for char in text:\n            if index<len(word) and word[index]==char:index+=1\n        return index==len(word)\n    best=-1\n    for i,word in enumerate(strs):\n        if all(i==j or not contained(word,other) for j,other in enumerate(strs)):\n            best=max(best,len(word))\n    return best\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def longest_uncommon_subsequence(strs):\n    def contained(word,text):\n        index=0\n        for char in text:\n            if index<len(word) and word[index]==char:index+=1\n        return index==len(word)\n    best=-1\n    for i,word in enumerate(strs):\n        if all(i==j or word!=other for j,other in enumerate(strs)):\n            best=max(best,len(word))\n    return best\n",
    "def longest_uncommon_subsequence(strs):\n    def contained(word,text):\n        index=0\n        for char in text:\n            if index<len(word) and word[index]==char:index+=1\n        return index==len(word)\n    best=-1\n    for i,word in enumerate(strs):\n        if all(word==other or not contained(word,other) for j,other in enumerate(strs)):\n            best=max(best,len(word))\n    return best\n"
  ],
