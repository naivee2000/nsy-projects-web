{
  "id": "leetcode-330",
  "version": 1,
  "status": "approved",
  "title": "Patching Array",
  "summary": "Given a sorted integer array nums and an integer n, ensure all numbers in the range [1, n] can be formed by summing some elements of the array.",
  "statement": "Given a sorted integer array nums and an integer n, ensure all numbers in the range [1, n] can be formed by summing some elements of the array. Return the fewest patches needed to achieve this.",
  "constraints": [
    "nums contains 1–1000 positive integers from 1 through 10000 in nondecreasing order; 1 <= n <= 2^31-1.",
    "Add as few positive integers as possible so every target from 1 through n is a subset sum. Each array occurrence or added occurrence can be used at most once in a given sum."
  ],
  "topics": [
    "greedy",
    "arrays",
    "intervals"
  ],
  "prerequisites": [
    "arrays",
    "greedy"
  ],
  "signature": {
    "name": "min_patches",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "n",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "int",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def min_patches(nums: list[int], n: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def min_patches(nums, n):\n    missing, index, patches = 1, 0, 0\n    while missing <= n:\n        if index < len(nums) and nums[index] <= missing:\n            missing += nums[index]\n            index += 1\n        else:\n            patches += 1\n            missing += missing\n    return patches\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def min_patches(nums, n):\n    missing, index, patches = 1, 0, 0\n    while missing <= n:\n        if index < len(nums) and nums[index] <= missing:\n            missing += nums[index]\n            index += 1\n        else:\n            patches += 1\n            missing += missing + 1\n    return patches\n",
    "def min_patches(nums, n):\n    missing, index, patches = 1, 0, 0\n    while missing <= n:\n        if index < len(nums) and nums[index] < missing:\n            missing += nums[index]\n            index += 1\n        else:\n            patches += 1\n            missing += missing\n    return patches\n"
  ],
  "target_time_complexity": "O(len(nums)+log n)",
  "target_space_complexity": "O(1)",
  "estimated_minutes": 50,
  "rubric": {
    "algorithmic_insight": 3,
    "prerequisites": 2,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 1
  },
  "hints": [
    "Track a contiguous range of attainable sums, not the individual subsets.",
    "If all sums below missing are attainable, an existing value at most missing extends the covered range.",
    "Start missing=1. Consume nums[i]<=missing by adding it to missing; otherwise patch exactly missing and double missing.",
    "When missing>n all required values are covered. Patching the first gap is necessary and maximizes coverage for one added value."
  ],
  "editorial": "Maintain that every sum in [0,missing) is attainable using processed occurrences. Consuming x<=missing extends coverage to [0,missing+x). If the next x is larger, no remaining existing value can form missing. Any useful patch must be at most missing; choosing exactly missing covers the most, doubling the range. The independent oracle performs breadth-first search over subset-sum sets and tries every candidate patch for small n.",
