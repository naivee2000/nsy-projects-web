{
  "id": "leetcode-59",
  "version": 1,
  "status": "approved",
  "title": "Spiral Matrix II",
  "summary": "Create an n x n matrix containing numbers from 1 to n^2 arranged in a spiral pattern starting from the top-left corner.",
  "statement": "Create an n x n matrix containing numbers from 1 to n^2 arranged in a spiral pattern starting from the top-left corner.",
  "constraints": [
    "1 <= n <= 20.",
    "Return an n×n matrix filled with 1 through n² in clockwise spiral order, starting at the top-left and moving right."
  ],
  "topics": [
    "matrices",
    "simulation"
  ],
  "prerequisites": [],
  "signature": {
    "name": "generate_spiral",
    "parameters": [
      {
        "name": "n",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[list[int]]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def generate_spiral(n: int) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def generate_spiral(n):\n    grid = [[0] * n for _ in range(n)]\n    top, bottom, left, right, value = 0, n - 1, 0, n - 1, 1\n    while top <= bottom and left <= right:\n        for col in range(left, right + 1):\n            grid[top][col] = value\n            value += 1\n        top += 1\n        for row in range(top, bottom + 1):\n            grid[row][right] = value\n            value += 1\n        right -= 1\n        if top <= bottom:\n            for col in range(right, left - 1, -1):\n                grid[bottom][col] = value\n                value += 1\n            bottom -= 1\n        if left <= right:\n            for row in range(bottom, top - 1, -1):\n                grid[row][left] = value\n                value += 1\n            left += 1\n    return grid\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def generate_spiral(n):\n    grid = [[0] * n for _ in range(n)]\n    top, bottom, left, right, value = 0, n - 1, 0, n - 1, 0\n    while top <= bottom and left <= right:\n        for col in range(left, right + 1):\n            grid[top][col] = value\n            value += 1\n        top += 1\n        for row in range(top, bottom + 1):\n            grid[row][right] = value\n            value += 1\n        right -= 1\n        if top <= bottom:\n            for col in range(right, left - 1, -1):\n                grid[bottom][col] = value\n                value += 1\n            bottom -= 1\n        if left <= right:\n            for row in range(bottom, top - 1, -1):\n                grid[row][left] = value\n                value += 1\n            left += 1\n    return grid\n",
    "def generate_spiral(n):\n    grid = [[0] * n for _ in range(n)]\n    top, bottom, left, right, value = 0, n - 1, 0, n - 1, 1\n    while top <= bottom and left <= right:\n        for col in range(left, right + 1):\n            grid[top][col] = value\n            value += 1\n        top += 1\n        for row in range(top, bottom + 1):\n            grid[row][right] = value\n            value += 1\n        right -= 1\n        if top <= bottom:\n            for col in range(right, left - 1, -1):\n                grid[bottom][col] = value\n                value += 1\n            bottom -= 1\n        if left <= right:\n            for row in range(bottom, top - 1, -1):\n                grid[row][left] = value\n                value += 1\n            left += 1\n    return [list(row) for row in zip(*grid)]\n"
