{
  "id": "leetcode-416",
  "version": 1,
  "status": "approved",
  "title": "Partition Equal Subset Sum",
  "summary": "Determine if an integer array can be divided into two subsets with equal sums.",
  "statement": "Determine if an integer array can be divided into two subsets with equal sums.",
  "constraints": [
    "1 <= nums.length <= 200; 1 <= nums[i] <= 100.",
    "Assign every occurrence to one of two subsets with equal sums; input order is irrelevant.",
    "Each occurrence may be used only once. Return existence, not the subsets or their count."
  ],
  "topics": [
    "arrays",
    "dynamic-programming"
  ],
  "prerequisites": [],
  "signature": {
    "name": "equal_subset_partition",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "bool",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def equal_subset_partition(nums: list[int]) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def equal_subset_partition(nums):\n    total = sum(nums)\n    if total%2:\n        return False\n    target = total//2\n    reachable = [False]*(target+1)\n    reachable[0] = True\n    for value in nums:\n        for subtotal in range(target,value-1,-1):\n            reachable[subtotal] |= reachable[subtotal-value]\n    return reachable[target]\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def equal_subset_partition(nums):\n    total = sum(nums)\n    if total%2:\n        return False\n    target = total//2\n    reachable = [False]*(target+1)\n    reachable[0] = True\n    for value in nums:\n        for subtotal in range(value,target+1):\n            reachable[subtotal] |= reachable[subtotal-value]\n    return reachable[target]\n",
    "def equal_subset_partition(nums):\n    return sum(nums)%2==0\n"
  ],
  "target_time_complexity": "O(n * target)",
  "target_space_complexity": "O(target)",
  "estimated_minutes": 35,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "If the total is odd, two equal integer sums are impossible.",
    "For an even total, ask whether a subset reaches half of it.",
    "Start reachable[0]=True. For each item update sums from target downward, using reachable[subtotal-value].",
    "Descending updates keep the current item from being reused. Time O(n*target), space O(target)."
  ],
  "editorial": "After processing a prefix, reachable[t] means some subset of that prefix sums to t. Updating from high sums down ensures the predecessor state still excludes the current item, preserving the 0/1 choice. If half the total is reachable, all unchosen items form the equal-sum complement.",
