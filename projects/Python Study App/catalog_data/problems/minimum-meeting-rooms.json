  "reference_solution": "def minimum_meeting_rooms(intervals):\n    import heapq\n    heap = []\n    for start, end in sorted(intervals):\n        if heap and heap[0] <= start: heapq.heapreplace(heap, end)\n        else: heapq.heappush(heap, end)\n    return len(heap)\n",
  "brute_force_solution": "def minimum_meeting_rooms(intervals):\n    import heapq\n    heap = []\n    for start, end in sorted(intervals):\n        if heap and heap[0] <= start: heapq.heapreplace(heap, end)\n        else: heapq.heappush(heap, end)\n    return len(heap)\n",
  "known_wrong_solutions": [
