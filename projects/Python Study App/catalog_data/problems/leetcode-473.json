  "starter_code": "def make_square(matchsticks: list[int]) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def make_square(matchsticks):\n    from functools import lru_cache\n    total = sum(matchsticks)\n    if total % 4 or max(matchsticks) > total//4:\n        return False\n    target = total//4\n    ordered = sorted(matchsticks, reverse=True)\n    @lru_cache(None)\n    def place(index, sides):\n        if index == len(ordered):\n            return True\n        seen = set()\n        for side, used in enumerate(sides):\n            if used in seen or used+ordered[index] > target:\n                continue\n            seen.add(used)\n            following = list(sides)\n            following[side] += ordered[index]\n            if place(index+1, tuple(sorted(following))):\n                return True\n        return False\n    return place(0, (0,0,0,0))\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def make_square(matchsticks):\n    return sum(matchsticks)%4==0\n",
    "def make_square(matchsticks):\n    target=sum(matchsticks)/4\n    sides=[0]*4\n    for stick in sorted(matchsticks,reverse=True):\n        for i in range(4):\n            if sides[i]+stick<=target:\n                sides[i]+=stick\n                break\n        else: return False\n    return len(set(sides))==1\n"
  ],
