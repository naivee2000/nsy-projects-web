{"id":"leetcode-693","version":1,"status":"approved","title":"Binary Number with Alternating Bits","summary":"Determine if a positive integer has alternating bits by verifying that no two consecutive bits are the same.","statement":"Determine if a positive integer has alternating bits by verifying that no two consecutive bits are the same.","constraints":["1 <= n <= 2^31-1.","Adjacent bits in the binary representation must always differ."],"topics":["bit-manipulation"],"prerequisites":[],"signature":{"name":"has_alternating_bits","parameters":[{"name":"n","annotation":"int","adapter":"raw","source_parameter":null}],"returns":"bool","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def has_alternating_bits(n: int) -> bool:\n    # Write your solution here.\n    pass\n","reference_solution":"def has_alternating_bits(n):\n    changed=n^(n>>1)\n    return changed&(changed+1)==0\n","brute_force_solution":null,"known_wrong_solutions":["def has_alternating_bits(n):\n    return bin(n).count('1')*2 in (n.bit_length(),n.bit_length()+1)\n","def has_alternating_bits(n):\n    return n&1 != (n>>1)&1\n"],"target_time_complexity":"O(1)","target_space_complexity":"O(1)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["XOR with a one-bit shift turns every alternating adjacency into one.","Compute changed=n^(n>>1) and test whether it is all binary ones.","An all-ones value x satisfies x&(x+1)==0.","Every original adjacent pair contributes one XOR bit; the leading bit also contributes one, so all ones is equivalent to full alternation."],"editorial":"Every original adjacent pair contributes one XOR bit; the leading bit also contributes one, so all ones is equivalent to full alternation.","tests":[{"id":"lc-693-1","arguments":[5],"expected":true,"comparator":"exact","visible":true,"explanation":"Binary 101 alternates.","expected_node_order":null},{"id":"lc-693-2","arguments":[7],"expected":false,"comparator":"exact","visible":true,"explanation":"Binary 111 contains equal adjacent bits.","expected_node_order":null},{"id":"lc-693-3","arguments":[1],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-4","arguments":[2],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-5","arguments":[3],"expected":false,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-6","arguments":[4],"expected":false,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-7","arguments":[6],"expected":false,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-8","arguments":[8],"expected":false,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-9","arguments":[10],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-10","arguments":[11],"expected":false,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-11","arguments":[21],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-12","arguments":[42],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-13","arguments":[85],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-693-14","arguments":[170],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null}],"variation_dimensions":[],"seed_problem_id":null,"prompt_version":null}
