  "reference_solution": "def target_pair_count(nums, target):\n    from collections import defaultdict\n    counts = defaultdict(int); answer = 0\n    for value in nums: answer += counts[target-value]; counts[value] += 1\n    return answer\n",
  "brute_force_solution": "def target_pair_count(nums, target):\n    from collections import defaultdict\n    counts = defaultdict(int); answer = 0\n    for value in nums: answer += counts[target-value]; counts[value] += 1\n    return answer\n",
