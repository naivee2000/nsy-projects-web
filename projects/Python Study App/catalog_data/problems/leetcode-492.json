  "starter_code": "def construct_rectangle(area: int) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def construct_rectangle(area):\n    from math import isqrt\n    width=isqrt(area)\n    while area%width:\n        width-=1\n    return [area//width,width]\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
