  "starter_code": "# Data structure supplied to this problem.\nclass TreeNode:\n    def __init__(\n        self,\n        val: int = 0,\n        left: \"TreeNode | None\" = None,\n        right: \"TreeNode | None\" = None,\n    ):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\ndef tree_right_side_view(root: TreeNode | None) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def tree_right_side_view(root):\n    answer = []\n    def visit(node, depth):\n        if node is None: return\n        if depth == len(answer): answer.append(node.val)\n        visit(node.right, depth+1); visit(node.left, depth+1)\n    visit(root, 0); return answer\n",
  "brute_force_solution": "def tree_right_side_view(root):\n    answer = []\n    def visit(node, depth):\n        if node is None: return\n        if depth == len(answer): answer.append(node.val)\n        visit(node.right, depth+1); visit(node.left, depth+1)\n    visit(root, 0); return answer\n",
  "known_wrong_solutions": [
    "def tree_right_side_view(root):\n    return None\n",
    "def tree_right_side_view(root):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(h)",
