  "starter_code": "def target_position_range(nums: list[int], target: int) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def target_position_range(nums, target):\n    from bisect import bisect_left, bisect_right\n    left = bisect_left(nums, target)\n    if left == len(nums) or nums[left] != target: return [-1, -1]\n    return [left, bisect_right(nums, target) - 1]\n",
  "brute_force_solution": "def target_position_range(nums, target):\n    from bisect import bisect_left, bisect_right\n    left = bisect_left(nums, target)\n    if left == len(nums) or nums[left] != target: return [-1, -1]\n    return [left, bisect_right(nums, target) - 1]\n",
  "known_wrong_solutions": [
    "def target_position_range(nums, target):\n    return None\n",
    "def target_position_range(nums, target):\n    return 0\n"
  ],
