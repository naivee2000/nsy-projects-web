  "starter_code": "def longest_palindromic_subsequence(s: str) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def longest_palindromic_subsequence(s):\n    n=len(s);dp=[0]*n\n    for left in range(n-1,-1,-1):\n        diagonal=0;dp[left]=1\n        for right in range(left+1,n):\n            old=dp[right]\n            if s[left]==s[right]:dp[right]=diagonal+2\n            else:dp[right]=max(dp[right],dp[right-1])\n            diagonal=old\n    return dp[-1]\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def longest_palindromic_subsequence(s):\n    best=0\n    for center in range(len(s)):\n        for left,right in ((center,center),(center,center+1)):\n            while left>=0 and right<len(s) and s[left]==s[right]:\n                best=max(best,right-left+1);left-=1;right+=1\n    return best\n",
    "def longest_palindromic_subsequence(s):\n    from collections import Counter\n    counts=Counter(s).values()\n    return sum(c//2*2 for c in counts)+int(any(c%2 for c in counts))\n"
  ],
