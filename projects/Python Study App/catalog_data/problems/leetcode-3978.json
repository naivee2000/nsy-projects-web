{"id":"leetcode-3978","version":1,"status":"approved","title":"Unique Middle Element","summary":"Given an integer array of odd length, determine if the middle element is unique by appearing exactly once.","statement":"Given an integer array of odd length, determine if the middle element is unique by appearing exactly once.","constraints":["nums has odd positive length.","Read the element at index len(nums)//2.","Return whether that value occurs exactly once in the whole array."],"topics":["arrays","counting"],"prerequisites":[],"signature":{"name":"is_middle_element_unique","parameters":[{"name":"nums","annotation":"list[int]","adapter":"raw","source_parameter":null}],"returns":"bool","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def is_middle_element_unique(nums: list[int]) -> bool:\n    # Write your solution here.\n    pass\n","reference_solution":"def is_middle_element_unique(nums):\n    return nums.count(nums[len(nums)//2])==1\n","brute_force_solution":null,"known_wrong_solutions":["def is_middle_element_unique(nums):\n    return nums.count(nums[len(nums)//2])==0\n","def is_middle_element_unique(nums):\n    return nums.count(nums[0])==1\n"],"target_time_complexity":"O(n)","target_space_complexity":"O(1)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["Locate the single middle index using integer division.","Capture its value.","Count that value throughout nums.","Exactly one occurrence means the middle value is unique."],"editorial":"Exactly one occurrence means the middle value is unique.","tests":[{"id":"lc-3978-1","arguments":[[1,2,3]],"expected":true,"comparator":"exact","visible":true,"explanation":"The middle value two appears only once.","expected_node_order":null},{"id":"lc-3978-2","arguments":[[1,2,1,2,3]],"expected":false,"comparator":"exact","visible":true,"explanation":"The middle value one also appears at index zero, so it is not unique.","expected_node_order":null},{"id":"lc-3978-3","arguments":[[1]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-4","arguments":[[1,1,1]],"expected":false,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-5","arguments":[[2,1,2]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-6","arguments":[[5,4,3,2,1]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-7","arguments":[[1,2,3,2,1]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-8","arguments":[[7,8,9,7,6]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-9","arguments":[[0,1,0]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-10","arguments":[[-1,0,1]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-11","arguments":[[3,3,2,3,3]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-12","arguments":[[1,4,2,4,3]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-13","arguments":[[9,8,7]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3978-14","arguments":[[2,5,2]],"expected":true,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null}],"variation_dimensions":[],"seed_problem_id":null,"prompt_version":null}
