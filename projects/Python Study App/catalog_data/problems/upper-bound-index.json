  "reference_solution": "def upper_bound_index(nums, target):\n    left, right = 0, len(nums)\n    while left < right:\n        middle = (left + right) // 2\n        if nums[middle] <= target: left = middle + 1\n        else: right = middle\n    return left\n",
  "brute_force_solution": "def upper_bound_index(nums, target):\n    left, right = 0, len(nums)\n    while left < right:\n        middle = (left + right) // 2\n        if nums[middle] <= target: left = middle + 1\n        else: right = middle\n    return left\n",
