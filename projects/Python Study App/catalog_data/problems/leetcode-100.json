  "title": "Same Tree",
  "summary": "Given the roots of two binary trees, p and q, create a function to determine if they are identical in structure and node values.",
  "statement": "Given the roots of two binary trees, p and q, create a function to determine if they are identical in structure and node values.",
  "constraints": [
    "Each tree contains 0–100 nodes.",
    "Node values range from -10,000 to 10,000.",
    "The displayed arrays use level order; null denotes a missing child."
  ],
  "topics": [
    "trees",
    "recursion",
    "depth-first-search"
  ],
  "prerequisites": [],
  "signature": {
    "name": "same_tree",
    "parameters": [
      {
        "name": "p",
