  "starter_code": "# Data structure supplied to this problem.\nclass TreeNode:\n    def __init__(\n        self,\n        val: int = 0,\n        left: \"TreeNode | None\" = None,\n        right: \"TreeNode | None\" = None,\n    ):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\ndef same_tree(p: TreeNode | None, q: TreeNode | None) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def same_tree(p, q):\n    if p is None or q is None:\n        return p is q\n    return p.val == q.val and same_tree(p.left, q.left) and same_tree(p.right, q.right)\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def same_tree(p, q):\n    if p is None or q is None:\n        return p is q\n    return same_tree(p.left, q.left) and same_tree(p.right, q.right)\n",
    "def same_tree(p, q):\n    if p is None or q is None:\n        return p is q\n    return p.val == q.val and same_tree(p.left, q.left) and True\n"
  ],
  "target_time_complexity": "O(n + m)",
  "target_space_complexity": "O(h) recursive stack",
  "estimated_minutes": 20,
