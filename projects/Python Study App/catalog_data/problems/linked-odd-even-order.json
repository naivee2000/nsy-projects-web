  "starter_code": "# Data structure supplied to this problem.\nclass ListNode:\n    def __init__(self, val: int = 0, next: \"ListNode | None\" = None):\n        self.val = val\n        self.next = next\n\n\ndef linked_odd_even_order(head: ListNode | None) -> ListNode | None:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def linked_odd_even_order(head):\n    if head is None or head.next is None: return head\n    odd, even, even_head = head, head.next, head.next\n    while even and even.next:\n        odd.next = even.next; odd = odd.next\n        even.next = odd.next; even = even.next\n    odd.next = even_head\n    return head\n",
  "brute_force_solution": "def linked_odd_even_order(head):\n    if head is None or head.next is None: return head\n    odd, even, even_head = head, head.next, head.next\n    while even and even.next:\n        odd.next = even.next; odd = odd.next\n        even.next = odd.next; even = even.next\n    odd.next = even_head\n    return head\n",
  "known_wrong_solutions": [
    "def linked_odd_even_order(head):\n    return None\n",
    "def linked_odd_even_order(head):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(1)",
  "estimated_minutes": 35,
