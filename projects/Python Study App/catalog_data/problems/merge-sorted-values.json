    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 0,
    "edge_cases": 0
  },
  "hints": [
    "The smallest unused value must be at one of the two current positions.",
    "Keep one pointer for each input.",
    "Append the smaller pointed value, then append the remainder when one list ends.",
    "The two-pointer merge is linear and stable."
  ],
  "editorial": "Compare the first unused value from each list, append the smaller, and advance only that list's pointer.",
