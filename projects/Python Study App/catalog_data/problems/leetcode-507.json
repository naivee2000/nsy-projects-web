  "starter_code": "def is_perfect_number(num: int) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def is_perfect_number(num):\n    from math import isqrt\n    if num<=1:return False\n    total=1\n    for divisor in range(2,isqrt(num)+1):\n        if num%divisor==0:\n            total+=divisor\n            partner=num//divisor\n            if partner!=divisor:total+=partner\n    return total==num\n",
  "brute_force_solution": null,
