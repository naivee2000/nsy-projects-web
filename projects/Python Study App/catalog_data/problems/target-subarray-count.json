  "reference_solution": "def target_subarray_count(nums, target):\n    from collections import defaultdict\n    counts = defaultdict(int, {0:1}); prefix = answer = 0\n    for value in nums: prefix += value; answer += counts[prefix-target]; counts[prefix] += 1\n    return answer\n",
  "brute_force_solution": "def target_subarray_count(nums, target):\n    from collections import defaultdict\n    counts = defaultdict(int, {0:1}); prefix = answer = 0\n    for value in nums: prefix += value; answer += counts[prefix-target]; counts[prefix] += 1\n    return answer\n",
