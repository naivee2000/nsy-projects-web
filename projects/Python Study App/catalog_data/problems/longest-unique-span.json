  "starter_code": "def longest_unique_span(text: str) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def longest_unique_span(text):\n    last_seen = {}\n    left = best = 0\n    for right, character in enumerate(text):\n        if character in last_seen and last_seen[character] >= left:\n            left = last_seen[character] + 1\n        last_seen[character] = right\n        best = max(best, right - left + 1)\n    return best\n",
  "brute_force_solution": "def longest_unique_span(text):\n    best = 0\n    for left in range(len(text) + 1):\n        seen = set()\n        for right in range(left, len(text)):\n            if text[right] in seen:\n                break\n            seen.add(text[right])\n            best = max(best, right - left + 1)\n    return best\n",
  "known_wrong_solutions": [
    "def longest_unique_span(text):\n    return None\n",
    "def longest_unique_span(text):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(k)",
  "estimated_minutes": 25,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 0,
    "edge_cases": 0
  },
  "hints": [
    "Maintain a window that is always duplicate-free.",
    "When a repeat appears, move the left edge beyond its previous occurrence.",
    "Map each character to its latest index and never move left backward.",
    "A sliding window visits each position a constant number of times."
  ],
  "editorial": "Track the latest position of every character. A duplicate inside the current window advances the left boundary.",
