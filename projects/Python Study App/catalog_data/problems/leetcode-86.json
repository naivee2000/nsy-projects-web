{
  "id": "leetcode-86",
  "version": 1,
  "status": "approved",
  "title": "Partition List",
  "summary": "Given the head of a linked list and a value x, rearrange the list so that all nodes with values less than x precede those with values greater than or equal to x, maintaining the original order within each partition.",
  "statement": "Given the head of a linked list and a value x, rearrange the list so that all nodes with values less than x precede those with values greater than or equal to x, maintaining the original order within each partition.",
  "constraints": [
    "0–200 nodes with values from -100 to 100; -200<=x<=200.",
    "Reconnect the original nodes so values <x precede values >=x. Preserve original relative order within each partition, retain every node, and do not rewrite node values."
  ],
  "topics": [
    "linked-lists",
    "two-pointers"
  ],
  "prerequisites": [],
  "signature": {
    "name": "partition_list",
    "parameters": [
      {
        "name": "head",
        "annotation": "ListNode | None",
        "adapter": "listnode",
        "source_parameter": null
      },
      {
        "name": "x",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "ListNode | None",
    "return_adapter": "listnode",
    "node_policy": "reuse_input_nodes",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "# Data structure supplied to this problem.\nclass ListNode:\n    def __init__(self, val: int = 0, next: \"ListNode | None\" = None):\n        self.val = val\n        self.next = next\n\n\ndef partition_list(head: ListNode | None, x: int) -> ListNode | None:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def partition_list(head, x):\n    small, large = ListNode(), ListNode()\n    low, high = small, large\n    while head:\n        following = head.next\n        head.next = None\n        if head.val < x:\n            low.next = head\n            low = head\n        else:\n            high.next = head\n            high = head\n        head = following\n    low.next = large.next\n    return small.next\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def partition_list(head, x):\n    small, large = ListNode(), ListNode()\n    low, high = small, large\n    while head:\n        following = head.next\n        head.next = None\n        if head.val <= x:\n            low.next = head\n            low = head\n        else:\n            high.next = head\n            high = head\n        head = following\n    low.next = large.next\n    return small.next\n",
    "def partition_list(head, x):\n    small, large = ListNode(), ListNode()\n    low, high = small, large\n    while head:\n        following = head.next\n        head.next = None\n        if head.val < x:\n            low.next = head\n            low = head\n        else:\n            high.next = head\n            high = head\n        head = following\n    high.next = small.next\n    return large.next\n"
  ],
  "target_time_complexity": "O(n)",
