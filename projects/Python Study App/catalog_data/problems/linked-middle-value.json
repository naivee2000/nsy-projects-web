  "starter_code": "# Data structure supplied to this problem.\nclass ListNode:\n    def __init__(self, val: int = 0, next: \"ListNode | None\" = None):\n        self.val = val\n        self.next = next\n\n\ndef linked_middle_value(head: ListNode | None) -> int | None:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def linked_middle_value(head):\n    slow = fast = head\n    while fast and fast.next: slow = slow.next; fast = fast.next.next\n    return None if slow is None else slow.val\n",
  "brute_force_solution": "def linked_middle_value(head):\n    slow = fast = head\n    while fast and fast.next: slow = slow.next; fast = fast.next.next\n    return None if slow is None else slow.val\n",
  "known_wrong_solutions": [
    "def linked_middle_value(head):\n    return None\n",
    "def linked_middle_value(head):\n    return 0\n"
  ],
