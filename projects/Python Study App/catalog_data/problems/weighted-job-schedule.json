  "title": "Weighted Schedule",
  "summary": "Select compatible jobs with maximum total profit.",
  "statement": "Jobs have start, end, and profit arrays. Select non-overlapping jobs with maximum profit; a job ending when another starts is compatible.",
  "constraints": [
    "Arrays have equal length up to 50,000.",
    "start < end and profit is non-negative."
  ],
  "topics": [
    "dynamic-programming",
    "binary-search",
    "intervals"
  ],
  "prerequisites": [
    "binary-search",
    "intervals"
  ],
  "signature": {
    "name": "max_weighted_schedule",
    "parameters": [
      {
        "name": "starts",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "ends",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "profits",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "int",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def max_weighted_schedule(starts: list[int], ends: list[int], profits: list[int]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def max_weighted_schedule(starts, ends, profits):\n    jobs = sorted(zip(starts, ends, profits), key=lambda job: job[1])\n    finish_times = [job[1] for job in jobs]\n    best = [0] * (len(jobs) + 1)\n    for index, (start, _end, profit) in enumerate(jobs, start=1):\n        compatible = bisect_left(finish_times, start + 1, 0, index - 1)\n        best[index] = max(best[index - 1], profit + best[compatible])\n    return best[-1]\n",
  "brute_force_solution": "def max_weighted_schedule(starts, ends, profits):\n    jobs = sorted(zip(starts, ends, profits), key=lambda job: job[1])\n    finish_times = [job[1] for job in jobs]\n    best = [0] * (len(jobs) + 1)\n    for index, (start, _end, profit) in enumerate(jobs, start=1):\n        compatible = bisect_left(finish_times, start + 1, 0, index - 1)\n        best[index] = max(best[index - 1], profit + best[compatible])\n    return best[-1]\n",
  "known_wrong_solutions": [
    "def max_weighted_schedule(starts, ends, profits):\n    return None\n",
    "def max_weighted_schedule(starts, ends, profits):\n    return 0\n"
  ],
  "target_time_complexity": "O(n log n)",
  "target_space_complexity": "O(n)",
  "estimated_minutes": 60,
  "rubric": {
    "algorithmic_insight": 3,
    "prerequisites": 2,
    "implementation": 2,
    "performance_pressure": 1,
    "edge_cases": 1
  },
  "hints": [
    "Sort jobs by finish time.",
    "For each job, compare skipping it with taking it after the best compatible prefix.",
    "Binary search the finish times to locate the last job ending no later than this start.",
    "A one-dimensional DP over finish-sorted jobs captures the optimum."
  ],
  "editorial": "Sort by end time. DP[index] stores the best profit among the first index jobs; binary search finds the compatible prefix for taking each job.",
