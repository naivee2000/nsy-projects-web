  "starter_code": "def balanced_pivot_index(nums: list[int]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def balanced_pivot_index(nums):\n    total = sum(nums); left = 0\n    for index, value in enumerate(nums):\n        if left == total - left - value: return index\n        left += value\n    return -1\n",
  "brute_force_solution": "def balanced_pivot_index(nums):\n    total = sum(nums); left = 0\n    for index, value in enumerate(nums):\n        if left == total - left - value: return index\n        left += value\n    return -1\n",
  "known_wrong_solutions": [
