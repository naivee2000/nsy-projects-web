  "starter_code": "def largest_land_region(grid: list[list[int]]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def largest_land_region(grid):\n    if not grid or not grid[0]: return 0\n    seen = set()\n    def area(r, c):\n        if not (0 <= r < len(grid) and 0 <= c < len(grid[0])) or not grid[r][c] or (r,c) in seen: return 0\n        seen.add((r,c)); return 1 + area(r+1,c) + area(r-1,c) + area(r,c+1) + area(r,c-1)\n    return max((area(r,c) for r in range(len(grid)) for c in range(len(grid[0]))), default=0)\n",
  "brute_force_solution": "def largest_land_region(grid):\n    if not grid or not grid[0]: return 0\n    seen = set()\n    def area(r, c):\n        if not (0 <= r < len(grid) and 0 <= c < len(grid[0])) or not grid[r][c] or (r,c) in seen: return 0\n        seen.add((r,c)); return 1 + area(r+1,c) + area(r-1,c) + area(r,c+1) + area(r,c-1)\n    return max((area(r,c) for r in range(len(grid)) for c in range(len(grid[0]))), default=0)\n",
  "known_wrong_solutions": [
    "def largest_land_region(grid):\n    return None\n",
    "def largest_land_region(grid):\n    return 0\n"
  ],
