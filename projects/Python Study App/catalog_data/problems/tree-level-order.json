{
  "id": "tree-level-order",
  "version": 1,
  "status": "approved",
  "title": "Tree Levels",
  "summary": "Read a tree one depth at a time.",
  "statement": "Return node values grouped by depth from left to right, beginning with the root level.",
  "constraints": [
    "0 <= node count <= 20,000",
    "Input uses level-order encoding."
  ],
  "topics": [
    "trees",
    "queues"
  ],
  "prerequisites": [
    "trees"
  ],
  "signature": {
    "name": "tree_level_order",
    "parameters": [
      {
        "name": "root",
        "annotation": "TreeNode | None",
        "adapter": "treenode",
        "source_parameter": null
      }
    ],
    "returns": "list[list[int]]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "# Data structure supplied to this problem.\nclass TreeNode:\n    def __init__(\n        self,\n        val: int = 0,\n        left: \"TreeNode | None\" = None,\n        right: \"TreeNode | None\" = None,\n    ):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\ndef tree_level_order(root: TreeNode | None) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def tree_level_order(root):\n    if not root:\n        return []\n    result = []\n    queue = deque([root])\n    while queue:\n        level = []\n        for _ in range(len(queue)):\n            node = queue.popleft()\n            level.append(node.val)\n            if node.left:\n                queue.append(node.left)\n            if node.right:\n                queue.append(node.right)\n        result.append(level)\n    return result\n",
  "brute_force_solution": "def tree_level_order(root):\n    if not root:\n        return []\n    result = []\n    queue = deque([root])\n    while queue:\n        level = []\n        for _ in range(len(queue)):\n            node = queue.popleft()\n            level.append(node.val)\n            if node.left:\n                queue.append(node.left)\n            if node.right:\n                queue.append(node.right)\n        result.append(level)\n    return result\n",
  "known_wrong_solutions": [
    "def tree_level_order(root):\n    return None\n",
    "def tree_level_order(root):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(w)",
  "estimated_minutes": 25,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 0,
    "edge_cases": 0
  },
  "hints": [
    "Breadth-first search naturally processes a tree by depth.",
    "The queue length at the start of a round is that level's size.",
    "Pop exactly level_size nodes, enqueue their children, then append the collected values.",
    "The queue stores at most one tree width."
  ],
  "editorial": "Use breadth-first search. Snapshot the queue length before each level so newly enqueued children belong to the next group.",
