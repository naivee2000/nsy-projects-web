  "starter_code": "def unique_text_permutations(text: str) -> list[str]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def unique_text_permutations(text):\n    answer = []\n    def build(prefix, remaining):\n        if not remaining: answer.append(prefix); return\n        for i, char in enumerate(remaining):\n            if i and char == remaining[i-1]: continue\n            build(prefix+char, remaining[:i]+remaining[i+1:])\n    build(\"\", \"\".join(sorted(text))); return answer\n",
  "brute_force_solution": "def unique_text_permutations(text):\n    answer = []\n    def build(prefix, remaining):\n        if not remaining: answer.append(prefix); return\n        for i, char in enumerate(remaining):\n            if i and char == remaining[i-1]: continue\n            build(prefix+char, remaining[:i]+remaining[i+1:])\n    build(\"\", \"\".join(sorted(text))); return answer\n",
  "known_wrong_solutions": [
    "def unique_text_permutations(text):\n    return None\n",
    "def unique_text_permutations(text):\n    return 0\n"
  ],
