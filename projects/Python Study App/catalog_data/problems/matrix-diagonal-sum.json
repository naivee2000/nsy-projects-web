  "reference_solution": "def matrix_diagonal_sum(matrix):\n    if not matrix or not matrix[0]: return 0\n    n = len(matrix)\n    return sum(matrix[i][i] + matrix[i][n-1-i] for i in range(n)) - (matrix[n//2][n//2] if n % 2 else 0)\n",
  "brute_force_solution": "def matrix_diagonal_sum(matrix):\n    if not matrix or not matrix[0]: return 0\n    n = len(matrix)\n    return sum(matrix[i][i] + matrix[i][n-1-i] for i in range(n)) - (matrix[n//2][n//2] if n % 2 else 0)\n",
  "known_wrong_solutions": [
