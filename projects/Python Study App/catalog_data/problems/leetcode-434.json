{"id":"leetcode-434","version":1,"status":"approved","title":"Number of Segments in a String","summary":"Determine the count of segments within a string, where a segment is a continuous sequence of non-blank characters.","statement":"Determine the count of segments within a string, where a segment is a continuous sequence of non-blank characters.","constraints":["0 <= len(s) <= 300.","Only the ordinary space character separates segments."],"topics":["strings","state-machines"],"prerequisites":[],"signature":{"name":"count_text_segments","parameters":[{"name":"s","annotation":"str","adapter":"raw","source_parameter":null}],"returns":"int","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def count_text_segments(s: str) -> int:\n    # Write your solution here.\n    pass\n","reference_solution":"def count_text_segments(s):\n return sum(char!=' ' and (index==0 or s[index-1]==' ') for index,char in enumerate(s))\n","brute_force_solution":null,"known_wrong_solutions":["def count_text_segments(s):\n return len(s.split(' '))\n","def count_text_segments(s):\n return len(s.split(','))\n"],"target_time_complexity":"O(n)","target_space_complexity":"O(1)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["A segment begins at a non-space character whose predecessor is absent or a space.","Scan once and count exactly those transitions.","For each index, add one when s[i] is non-space and i is zero or s[i-1] is space.","Every maximal non-space run has exactly one starting transition."],"editorial":"Every maximal non-space run has exactly one starting transition.","tests":[{"id":"lc-434-1","arguments":["Hello, my name is John"],"expected":5,"comparator":"exact","visible":true,"explanation":"Five runs of non-space characters form five segments.","expected_node_order":null},{"id":"lc-434-2","arguments":["   "],"expected":0,"comparator":"exact","visible":true,"explanation":"Spaces alone contain no segment.","expected_node_order":null},{"id":"lc-434-3","arguments":[""],"expected":0,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-4","arguments":["a"],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-5","arguments":[" a"],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-6","arguments":["a "],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-7","arguments":[" a "],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-8","arguments":["a b"],"expected":2,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-9","arguments":["a  b"],"expected":2,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-10","arguments":["hello,world"],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-11","arguments":["hello, world"],"expected":2,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-12","arguments":["! !"],"expected":2,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-13","arguments":["one\ttwo"],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-14","arguments":["  many   gaps  "],"expected":2,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-15","arguments":["x,y,z"],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-434-16","arguments":[" end"],"expected":1,"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null}],"variation_dimensions":[],"seed_problem_id":null,"prompt_version":null}
