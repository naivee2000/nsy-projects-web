  "version": 1,
  "status": "approved",
  "title": "One-Use Combination Sum",
  "summary": "Choose unique combinations that reach a target.",
  "statement": "Each candidate occurrence may be used at most once. Return all unique nondecreasing combinations summing to target; result order does not matter.",
  "constraints": [
    "1 <= candidate <= 50",
    "0 <= len(candidates) <= 20",
    "1 <= target <= 100"
  ],
  "topics": [
    "backtracking",
    "sorting"
  ],
  "prerequisites": [
    "recursion"
  ],
  "signature": {
    "name": "combination_sum_once",
    "parameters": [
      {
        "name": "candidates",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "target",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[list[int]]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def combination_sum_once(candidates: list[int], target: int) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def combination_sum_once(candidates, target):\n    candidates.sort()\n    result = []\n\n    def search(start, remaining, path):\n        if remaining == 0:\n            result.append(path[:])\n            return\n        for index in range(start, len(candidates)):\n            if index > start and candidates[index] == candidates[index - 1]:\n                continue\n            value = candidates[index]\n            if value > remaining:\n                break\n            path.append(value)\n            search(index + 1, remaining - value, path)\n            path.pop()\n\n    search(0, target, [])\n    return result\n",
  "brute_force_solution": "def combination_sum_once(candidates, target):\n    candidates.sort()\n    result = []\n\n    def search(start, remaining, path):\n        if remaining == 0:\n            result.append(path[:])\n            return\n        for index in range(start, len(candidates)):\n            if index > start and candidates[index] == candidates[index - 1]:\n                continue\n            value = candidates[index]\n            if value > remaining:\n                break\n            path.append(value)\n            search(index + 1, remaining - value, path)\n            path.pop()\n\n    search(0, target, [])\n    return result\n",
  "known_wrong_solutions": [
    "def combination_sum_once(candidates, target):\n    return None\n",
    "def combination_sum_once(candidates, target):\n    return 0\n"
  ],
  "target_time_complexity": "O(2ⁿ)",
  "target_space_complexity": "O(n) excluding output",
  "estimated_minutes": 40,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 2,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 1
  },
  "hints": [
    "Sort first so duplicates become adjacent and large values can stop a branch.",
    "At one recursion depth, skip a candidate equal to the previous candidate.",
    "Recurse with index + 1 because each occurrence is single-use.",
    "Backtracking explores choices while duplicate skipping keeps outputs unique."
  ],
  "editorial": "Sort candidates, explore include choices from a moving start index, and skip equal siblings at each recursive depth.",
