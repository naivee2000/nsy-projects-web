{"id":"leetcode-1108","version":1,"status":"approved","title":"Defanging an IP Address","summary":"For a valid IPv4 address, replace each period with '[.]' to create a defanged version.","statement":"For a valid IPv4 address, replace each period with '[.]' to create a defanged version.","constraints":["address is a valid IPv4 dotted-decimal string.","Replace each period with [.] exactly."],"topics":["strings"],"prerequisites":[],"signature":{"name":"defang_ip_address","parameters":[{"name":"address","annotation":"str","adapter":"raw","source_parameter":null}],"returns":"str","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def defang_ip_address(address: str) -> str:\n    # Write your solution here.\n    pass\n","reference_solution":"def defang_ip_address(address):\n return address.replace('.','[.]')\n","brute_force_solution":null,"known_wrong_solutions":["def defang_ip_address(address):\n return address.replace('.','[]')\n","def defang_ip_address(address):\n return address.replace('1','[.]')\n"],"target_time_complexity":"O(n)","target_space_complexity":"O(n)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["Defanging is a literal separator substitution.","Use the string replace operation on periods only.","Replace each dot with the three-character token [.].","IPv4 has exactly three period separators, and no other characters are changed."],"editorial":"IPv4 has exactly three period separators, and no other characters are changed.","tests":[{"id":"lc-1108-1","arguments":["1.1.1.1"],"expected":"1[.]1[.]1[.]1","comparator":"exact","visible":true,"explanation":"The defanged form is 1[.]1[.]1[.]1.","expected_node_order":null},{"id":"lc-1108-2","arguments":["255.100.50.0"],"expected":"255[.]100[.]50[.]0","comparator":"exact","visible":true,"explanation":"Every one of the three dots is bracke