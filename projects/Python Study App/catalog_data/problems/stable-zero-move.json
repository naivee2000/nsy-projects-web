  "reference_solution": "def stable_zero_move(nums):\n    kept = [value for value in nums if value != 0]\n    return kept + [0] * (len(nums) - len(kept))\n",
  "brute_force_solution": "def stable_zero_move(nums):\n    kept = [value for value in nums if value != 0]\n    return kept + [0] * (len(nums) - len(kept))\n",
