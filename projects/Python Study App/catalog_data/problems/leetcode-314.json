{
  "id": "leetcode-314",
  "version": 1,
  "status": "approved",
  "title": "Binary Tree Vertical Order Traversal",
  "summary": "For a given binary tree, output the nodes' values in a vertical order traversal, from top to bottom within each column.",
  "statement": "For a given binary tree, output the nodes' values in a vertical order traversal, from top to bottom within each column. If nodes are in the same row and column, list them from left to right.",
  "constraints": [
    "root has 0–100 nodes with values from -100 through 100.",
    "The root is in column 0, a left child in column-1, and a right child in column+1. Return columns left to right; within each column, order by depth, then left-to-right position, NOT node value."
  ],
  "topics": [
    "trees",
    "breadth-first-search",
    "recursion"
  ],
  "prerequisites": [],
  "signature": {
    "name": "vertical_order",
    "parameters": [
      {
        "name": "root",
        "annotation": "TreeNode",
        "adapter": "treenode",
        "source_parameter": null
      }
    ],
    "returns": "list[list[int]]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "# Data structure supplied to this problem.\nclass TreeNode:\n    def __init__(\n        self,\n        val: int = 0,\n        left: \"TreeNode | None\" = None,\n        right: \"TreeNode | None\" = None,\n    ):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\ndef vertical_order(root: TreeNode) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def vertical_order(root):\n    from collections import deque\n    if root is None:\n        return []\n    columns = {}\n    queue = deque([(root, 0)])\n    low = high = 0\n    while queue:\n        node, column = queue.popleft()\n        columns.setdefault(column, []).append(node.val)\n        low, high = min(low, column), max(high, column)\n        if node.left:\n            queue.append((node.left, column - 1))\n        if node.right:\n            queue.append((node.right, column + 1))\n    return [columns[column] for column in range(low, high + 1)]\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def vertical_order(root):\n    columns = {}\n    def visit(node, column):\n        if node:\n            columns.setdefault(column, []).append(node.val)\n            visit(node.left, column-1)\n            visit(node.right, column+1)\n    visit(root, 0)\n    return [columns[column] for column in sorted(columns)]\n",
    "def vertical_order(root):\n    from collections import deque\n    if root is None:\n        return []\n    columns = {}\n    queue = deque([(root, 0)])\n    low = high = 0\n    while queue:\n        node, column = queue.popleft()\n        columns.setdefault(column, []).append(node.val)\n        low, high = min(low, column), max(high, column)\n        if node.left:\n            queue.append((node.left, column - 1))\n        if node.right:\n            queue.append((node.right, column + 1))\n    return [sorted(columns[column]) for column in range(low, high + 1)]\n"
  ],
