{
  "id": "leetcode-68",
  "version": 1,
  "status": "approved",
  "title": "Text Justification",
  "summary": "Given an array of strings words and a width maxWidth, arrange the text so each line has exactly maxWidth characters, fully justifying both left and right.",
  "statement": "Given an array of strings words and a width maxWidth, arrange the text so each line has exactly maxWidth characters, fully justifying both left and right. Pack words greedily, padding with spaces as needed. Distribute extra spaces evenly between words, giving more to left slots if necessary. For the last line, left-justify with no extra spaces between words. Each word is a sequence of non-space characters, with lengths not exceeding maxWidth, and the words array contains at least one word.",
  "constraints": [
    "1–300 words; each has 1–20 non-space English letters or symbols. maxWidth is 1–100 and is at least every word's length.",
    "Pack as many whole words as fit on each line, keeping their original order. Every output line must be exactly maxWidth characters, including spaces.",
    "On nonfinal lines distribute spaces evenly between words, placing leftover spaces in the leftmost gaps. Single-word lines and the final line use single spaces between words, then trailing spaces."
  ],
  "topics": [
    "strings",
    "greedy"
  ],
  "prerequisites": [
    "strings",
    "greedy"
  ],
  "signature": {
    "name": "justify_text",
    "parameters": [
      {
        "name": "words",
        "annotation": "list[str]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "maxWidth",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[str]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def justify_text(words: list[str], maxWidth: int) -> list[str]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def justify_text(words, maxWidth):\n    output = []\n    start = 0\n    while start < len(words):\n        end = start\n        letters = 0\n        while end < len(words) and letters + len(words[end]) + end - start <= maxWidth:\n            letters += len(words[end])\n            end += 1\n        count = end - start\n        if end == len(words) or count == 1:\n            line = \" \".join(words[start:end]).ljust(maxWidth)\n        else:\n            spaces, extra = divmod(maxWidth - letters, count - 1)\n            parts = []\n            for offset in range(count - 1):\n                parts.append(words[start + offset] + \" \" * (spaces + (offset < extra)))\n            line = \"\".join(parts) + words[end - 1]\n        output.append(line)\n        start = end\n    return output\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def justify_text(words, maxWidth):\n    output = []\n    start = 0\n    while start < len(words):\n        end = start\n        letters = 0\n        while end < len(words) and letters + len(words[end]) + end - start <= maxWidth:\n            letters += len(words[end])\n            end += 1\n        count = end - start\n        if count == 1:\n            line = \" \".join(words[start:end]).ljust(maxWidth)\n        else:\n            spaces, extra = divmod(maxWidth - letters, count - 1)\n            parts = []\n            for offset in range(count - 1):\n                parts.append(words[start + offset] + \" \" * (spaces + (offset < extra)))\n            line = \"\".join(parts) + words[end - 1]\n        output.append(line)\n        start = end\n    return output\n",
    "def justify_text(words, maxWidth):\n    output = []\n    start = 0\n    while start < len(words):\n        end = start\n        letters = 0\n        while end < len(words) and letters + len(words[end]) + end - start <= maxWidth:\n            letters += len(words[end])\n            end += 1\n        count = end - start\n        if end == len(words) or count == 1:\n            line = \" \".join(words[start:end]).ljust(maxWidth)\n        else:\n            spaces, extra = divmod(maxWidth - letters, count - 1)\n            parts = []\n            for offset in range(count - 1):\n                parts.append(words[start + offset] + \" \" * (spaces + (offset >= count - 1 - extra)))\n            line = \"\".join(parts) + words[end - 1]\n        output.append(line)\n        start = end\n    return output\n"
  ],
