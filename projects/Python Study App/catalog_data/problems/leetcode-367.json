  "starter_code": "def is_perfect_square(num: int) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def is_perfect_square(num):\n    left,right = 1,num\n    while left <= right:\n        middle = (left+right)//2\n        value = middle*middle\n        if value == num:\n            return True\n        if value < num:\n            left = middle+1\n        else:\n            right = middle-1\n    return False\n",
  "brute_force_solution": null,
