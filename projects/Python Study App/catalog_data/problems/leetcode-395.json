  "starter_code": "def longest_repeating_substring(s: str, k: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def longest_repeating_substring(s, k):\n    def solve(left,right):\n        if right-left < k:\n            return 0\n        counts = {}\n        for index in range(left,right):\n            char = s[index]\n            counts[char] = counts.get(char,0)+1\n        bad = {char for char,count in counts.items() if count<k}\n        if not bad:\n            return right-left\n        best, start = 0,left\n        for index in range(left,right):\n            if s[index] in bad:\n                best = max(best,solve(start,index))\n                start = index+1\n        return max(best,solve(start,right))\n    return solve(0,len(s))\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def longest_repeating_substring(s,k):\n    from collections import Counter\n    return sum(count for count in Counter(s).values() if count>=k)",
    "def longest_repeating_substring(s,k):\n    from itertools import groupby\n    return max((n for _,group in groupby(s) if (n:=len(list(group)))>=k),default=0)"
  ],
