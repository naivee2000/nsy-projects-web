{"id":"leetcode-2545","version":1,"status":"approved","title":"Sort the Students by Their Kth Score","summary":"Given an m x n matrix score with distinct integers, sort the rows of the matrix based on the scores in the kth exam (0-indexed) in descending order.","statement":"Given an m x n matrix score with distinct integers, sort the rows of the matrix based on the scores in the kth exam (0-indexed) in descending order. Return the sorted matrix.","constraints":["Each row stores one student's exam scores.","All scores are distinct, and k is a zero-based exam column.","Return complete rows sorted by column k in descending order."],"topics":["matrices","sorting","arrays"],"prerequisites":[],"signature":{"name":"sort_students_by_exam","parameters":[{"name":"score","annotation":"list[list[int]]","adapter":"raw","source_parameter":null},{"name":"k","annotation":"int","adapter":"raw","source_parameter":null}],"returns":"list[list[int]]","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def sort_students_by_exam(score: list[list[int]], k: int) -> list[list[int]]:\n    # Write your solution here.\n    pass\n","reference_solution":"def sort_students_by_exam(score,k):\n    return sorted(score,key=lambda row:row[k],reverse=True)\n","brute_force_solution":null,"known_wrong_solutions":["def sort_students_by_exam(score,k):\n    return sorted(score,key=lambda row:row[k],reverse=False)\n","def sort_students_by_exam(score,k):\n    return sorted(score,key=lambda row:row[0],reverse=True)\n"],"target_time_complexity":"O(m log m)","target_space_complexity":"O(m)","estimated_minutes":35,"rubric":{"algorithmic_insight":2,"prerequisites":1,"implementation":1,"performance_pressure":1,"edge_cases":0},"hints":["Treat each entire student row as one sortable record.","Use the kth entry as the sort key.","Request descending order while preserving every row unchanged.","Distinct scores in the selected column make the key order unambiguous."],"editorial":"Distinct scores in the selected column make the key order unambiguous.","tests":[{"id":"lc-2545-1","arguments":[[[10,6,9,1],[7,5,11,2],[4,8,3,15]],2],"expected":[[7,5,11,2],[10,6,9,1],[4,8,3,15]],"comparator":"exact","visible":true,"explanation":"Column two values 11, 9, and 3 determine the returned row order.","expected_node_order":null},{"id":"lc-2545-2","arguments":[[[3,4],[5,6]],0],"expected":[[5,6],[3,4]],"comparator":"exact","visible":true,"explanation":"First-exam scores five and three place the second row first.","expected_node_order":null},{"id":"lc-2545-3","arguments":[[[1]],0],"expected":[[1]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-4","arguments":[[[1,2]],1],"expected":[[1,2]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-5","arguments":[[[1],[2]],0],"expected":[[2],[1]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-6","arguments":[[[9,1],[8,2],[7,3]],1],"expected":[[7,3],[8,2],[9,1]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-7","arguments":[[[1,9],[2,8],[3,7]],0],"expected":[[3,7],[2,8],[1,9]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-8","arguments":[[[4,1,7],[3,9,2]],1],"expected":[[3,9,2],[4,1,7]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-9","arguments":[[[10,20],[30,40],[50,60]],0],"expected":[[50,60],[30,40],[10,20]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-10","arguments":[[[6,2,8],[1,9,3],[7,4,5]],2],"expected":[[6,2,8],[7,4,5],[1,9,3]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-11","arguments":[[[100,1],[2,99],[50,51]],1],"expected":[[2,99],[50,51],[100,1]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-12","arguments":[[[5,8,1],[9,2,7],[3,6,4]],0],"expected":[[9,2,7],[5,8,1],[3,6,4]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-13","arguments":[[[1,8,4,7],[2,6,9,3]],3],"expected":[[1,8,4,7],[2,6,9,3]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-14","arguments":[[[11,5],[3,17],[13,7],[19,2]],0],"expected":[[19,2],[13,7],[11,5],[3,17]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-15","arguments":[[[20,3,14],[8,18,1],[9,2,17]],1],"expected":[[8,18,1],[20,3,14],[9,2,17]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-2545-16","arguments":[[[4,12,20],[8,16,24],[6,18,2],[10,14,22]],2],"expected":[[8,16,24],[10,14,22],[4,12,20],[6,18,2]],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null}],"variation_dimensions":[],"seed_problem_id":null,"prompt_version":null}
