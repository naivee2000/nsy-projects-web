  "starter_code": "def normalized_palindrome(text: str) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def normalized_palindrome(text):\n    left, right = 0, len(text) - 1\n    while left < right:\n        while left < right and not text[left].isalnum():\n            left += 1\n        while left < right and not text[right].isalnum():\n            right -= 1\n        if text[left].lower() != text[right].lower():\n            return False\n        left += 1\n        right -= 1\n    return True\n",
  "brute_force_solution": "def normalized_palindrome(text):\n    normalized = \"\".join(character.lower() for character in text if character.isalnum())\n    return normalized == normalized[::-1]\n",
  "known_wrong_solutions": [
    "def normalized_palindrome(text):\n    return None\n",
    "def normalized_palindrome(text):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(1)",
  "estimated_minutes": 15,
