  "starter_code": "# Data structure supplied to this problem.\nclass TreeNode:\n    def __init__(\n        self,\n        val: int = 0,\n        left: \"TreeNode | None\" = None,\n        right: \"TreeNode | None\" = None,\n    ):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\ndef recursive_leaf_count(root: TreeNode | None) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def recursive_leaf_count(root):\n    if root is None: return 0\n    if root.left is None and root.right is None: return 1\n    return recursive_leaf_count(root.left) + recursive_leaf_count(root.right)\n",
  "brute_force_solution": "def recursive_leaf_count(root):\n    if root is None: return 0\n    if root.left is None and root.right is None: return 1\n    return recursive_leaf_count(root.left) + recursive_leaf_count(root.right)\n",
