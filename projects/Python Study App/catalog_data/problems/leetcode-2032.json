{"id":"leetcode-2032","version":1,"status":"approved","title":"Two Out of Three","summary":"Provide an array of unique integers that appear in at least two of the three given integer arrays, in any order.","statement":"Provide an array of unique integers that appear in at least two of the three given integer arrays, in any order.","constraints":["Each input has 1 through 100 integers.","Return each distinct value occurring in at least two of the three arrays.","Output order does not matter."],"topics":["sets","arrays"],"prerequisites":[],"signature":{"name":"values_in_at_least_two","parameters":[{"name":"nums1","annotation":"list[int]","adapter":"raw","source_parameter":null},{"name":"nums2","annotation":"list[int]","adapter":"raw","source_parameter":null},{"name":"nums3","annotation":"list[int]","adapter":"raw","source_parameter":null}],"returns":"list[int]","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def values_in_at_least_two(nums1: list[int], nums2: list[int], nums3: list[int]) -> list[int]:\n    # Write your solution here.\n    pass\n","reference_solution":"def values_in_at_least_two(nums1,nums2,nums3):\n    first,second,third=set(nums1),set(nums2),set(nums3)\n    return list((first&second)|(first&third)|(second&third))\n","brute_force_solution":null,"known_wrong_solutions":["def values_in_at_least_two(nums1,nums2,nums3):\n    first,second,third=set(nums1),set(nums2),set(nums3)\n    return list((first&second)|(first&third))\n","def values_in_at_least_two(nums1,nums2,nums3):\n    first,second,third=set(nums1),set(nums2),set()\n    return list((first&second)|(first&third)|(second&third))\n"],"target_time_complexity":"O(total input)","target_space_complexity":"O(unique values)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["Duplicates inside one array must not count as multipl