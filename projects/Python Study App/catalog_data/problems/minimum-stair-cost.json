  "starter_code": "def minimum_stair_cost(costs: list[int]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def minimum_stair_cost(costs):\n    previous_two = previous_one = 0\n    for cost in costs: previous_two, previous_one = previous_one, cost + min(previous_one, previous_two)\n    return min(previous_one, previous_two)\n",
  "brute_force_solution": "def minimum_stair_cost(costs):\n    previous_two = previous_one = 0\n    for cost in costs: previous_two, previous_one = previous_one, cost + min(previous_one, previous_two)\n    return min(previous_one, previous_two)\n",
  "known_wrong_solutions": [
    "def minimum_stair_cost(costs):\n    return None\n",
    "def minimum_stair_cost(costs):\n    return 0\n"
  ],
