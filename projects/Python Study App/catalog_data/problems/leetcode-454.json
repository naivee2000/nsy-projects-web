{
  "id": "leetcode-454",
  "version": 1,
  "status": "approved",
  "title": "4Sum II",
  "summary": "For four integer arrays of equal length n, count the quadruplets (i, j, k, l) where 0 <= i, j, k, l < n and the sum of the elements at these indices from each array equals zero.",
  "statement": "For four integer arrays of equal length n, count the quadruplets (i, j, k, l) where 0 <= i, j, k, l < n and the sum of the elements at these indices from each array equals zero.",
  "constraints": [
    "All four arrays have the same length n, 1 <= n <= 200; values lie in -2^28..2^28.",
    "Choose one index independently from each array and count tuples whose four values sum to zero.",
    "Equal values at different indices count separately. Return a count, not unique quadruplet values from one array."
  ],
  "topics": [
    "arrays",
    "hash-maps"
  ],
  "prerequisites": [],
  "signature": {
