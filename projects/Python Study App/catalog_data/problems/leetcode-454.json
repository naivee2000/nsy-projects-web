    "immutable_parameters": []
  },
  "starter_code": "def four_array_zero_sum_count(nums1: list[int], nums2: list[int], nums3: list[int], nums4: list[int]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def four_array_zero_sum_count(nums1, nums2, nums3, nums4):\n    counts = {}\n    for a in nums1:\n        for b in nums2:\n            counts[a+b] = counts.get(a+b,0)+1\n    return sum(counts.get(-c-d,0) for c in nums3 for d in nums4)\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def four_array_zero_sum_count(nums1, nums2, nums3, nums4):\n    counts = {}\n    for a in nums1:\n        for b in nums2:\n            counts[a+b] = 1\n    return sum(counts.get(-c-d,0) for c in nums3 for d in nums4)\n",
    "def four_array_zero_sum_count(nums1, nums2, nums3, nums4):\n    counts = {}\n    for a in nums1:\n        for b in nums2:\n            counts[a+b] = counts.get(a+b,0)+1\n    return sum(counts.get(c+d,0) for c in nums3 for d in nums4)\n"
  ],
  "target_time_complexity": "O(n^2) expected",
  "target_space_complexity": "O(n^2)",
  "estimated_minutes": 35,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "Split the sum into two independent pairs.",
    "Count every nums1+nums2 sum, then look up the negative of each nums3+nums4 sum.",
    "Accumulate pair frequencies, not just membership; add that frequency for every right-pair index choice.",
    "There are n^2 pairs per side instead of n^4 explicit tuples. Multiplicities are preserved by frequency addition."
  ],
  "editorial": "Each four-index tuple has a unique left and right pair. Their sums must be opposites; frequency lookup counts all compatible left pairs, including repeated values at distinct indices. The oracle enumerates the Cartesian product of four small arrays.",
