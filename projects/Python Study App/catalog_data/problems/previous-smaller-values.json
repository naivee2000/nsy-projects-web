  "starter_code": "def previous_smaller_values(nums: list[int]) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def previous_smaller_values(nums):\n    stack = []; answer = []\n    for value in nums:\n        while stack and stack[-1] >= value: stack.pop()\n        answer.append(stack[-1] if stack else -1); stack.append(value)\n    return answer\n",
  "brute_force_solution": "def previous_smaller_values(nums):\n    stack = []; answer = []\n    for value in nums:\n        while stack and stack[-1] >= value: stack.pop()\n        answer.append(stack[-1] if stack else -1); stack.append(value)\n    return answer\n",
  "known_wrong_solutions": [
    "def previous_smaller_values(nums):\n    return None\n",
    "def previous_smaller_values(nums):\n    return 0\n"
  ],
