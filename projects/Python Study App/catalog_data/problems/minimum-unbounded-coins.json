  "starter_code": "def minimum_unbounded_coins(coins: list[int], amount: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def minimum_unbounded_coins(coins, amount):\n    best = [amount + 1] * (amount + 1); best[0] = 0\n    for value in range(1, amount + 1):\n        for coin in coins:\n            if coin <= value: best[value] = min(best[value], 1 + best[value-coin])\n    return -1 if best[amount] > amount else best[amount]\n",
  "brute_force_solution": "def minimum_unbounded_coins(coins, amount):\n    best = [amount + 1] * (amount + 1); best[0] = 0\n    for value in range(1, amount + 1):\n        for coin in coins:\n            if coin <= value: best[value] = min(best[value], 1 + best[value-coin])\n    return -1 if best[amount] > amount else best[amount]\n",
  "known_wrong_solutions": [
    "def minimum_unbounded_coins(coins, amount):\n    return None\n",
    "def minimum_unbounded_coins(coins, amount):\n    return 0\n"
  ],
