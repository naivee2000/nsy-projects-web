  "id": "leetcode-18",
  "version": 1,
  "status": "approved",
  "title": "4Sum",
  "summary": "Given an array of integers nums, return all unique quadruplets [nums[a], nums[b], nums[c], nums[d]] such that: - 0 <= a, b, c, d < n (where n is the length of the array) - a, b, c, and d are distinct indices - The sum of the elements at these indices equals the target value Ensure the quadruplets are returned in any order.",
  "statement": "Given an array of integers nums, return all unique quadruplets [nums[a], nums[b], nums[c], nums[d]] such that: - 0 <= a, b, c, d < n (where n is the length of the array) - a, b, c, and d are distinct indices - The sum of the elements at these indices equals the target value Ensure the quadruplets are returned in any order.",
  "constraints": [
    "1 <= nums.length <= 200; -10^9 <= nums[i], target <= 10^9.",
    "Use four distinct indices. Equal values at different indices may be used.",
    "Return each value quadruplet once; quadruplets and their values may appear in any order."
  ],
  "topics": [
