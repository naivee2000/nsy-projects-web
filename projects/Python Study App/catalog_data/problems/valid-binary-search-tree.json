{
  "id": "valid-binary-search-tree",
  "version": 1,
  "status": "approved",
  "title": "Validate Search-Tree Ordering",
  "summary": "Check global ordering constraints in a binary tree.",
  "statement": "Return whether every node is strictly greater than all values in its left subtree and strictly smaller than all values in its right subtree.",
  "constraints": [
    "0 <= node count <= 20,000",
    "Duplicate values make the tree invalid."
  ],
  "topics": [
    "trees",
    "recursion"
  ],
  "prerequisites": [
    "trees"
  ],
  "signature": {
    "name": "is_valid_bst",
    "parameters": [
      {
        "name": "root",
        "annotation": "TreeNode | None",
        "adapter": "treenode",
        "source_parameter": null
      }
    ],
    "returns": "bool",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "# Data structure supplied to this problem.\nclass TreeNode:\n    def __init__(\n        self,\n        val: int = 0,\n        left: \"TreeNode | None\" = None,\n        right: \"TreeNode | None\" = None,\n    ):\n        self.val = val\n        self.left = left\n        self.right = right\n\n\ndef is_valid_bst(root: TreeNode | None) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def is_valid_bst(root):\n    def valid(node, lower, upper):\n        if not node:\n            return True\n        if not lower < node.val < upper:\n            return False\n        return valid(node.left, lower, node.val) and valid(node.right, node.val, upper)\n\n    return valid(root, float(\"-inf\"), float(\"inf\"))\n",
  "brute_force_solution": "def is_valid_bst(root):\n    def valid(node, lower, upper):\n        if not node:\n            return True\n        if not lower < node.val < upper:\n            return False\n        return valid(node.left, lower, node.val) and valid(node.right, node.val, upper)\n\n    return valid(root, float(\"-inf\"), float(\"inf\"))\n",
  "known_wrong_solutions": [
    "def is_valid_bst(root):\n    return None\n",
    "def is_valid_bst(root):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(h)",
  "estimated_minutes": 30,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "Comparing only a node with its children is insufficient.",
    "Carry the legal lower and upper bound down the tree.",
    "The left child inherits the upper bound node.val; the right inherits the lower bound.",
    "Every node must fall strictly inside its inherited range."
  ],
  "editorial": "Depth-first search carries bounds imposed by every ancestor, which enforces the global search-tree property.",
