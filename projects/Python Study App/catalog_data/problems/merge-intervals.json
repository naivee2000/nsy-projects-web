    "immutable_parameters": []
  },
  "starter_code": "def merge_intervals(intervals: list[list[int]]) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def merge_intervals(intervals):\n    if not intervals:\n        return []\n    intervals = sorted(intervals)\n    merged = [intervals[0][:]]\n    for start, end in intervals[1:]:\n        if start <= merged[-1][1]:\n            merged[-1][1] = max(merged[-1][1], end)\n        else:\n            merged.append([start, end])\n    return merged\n",
  "brute_force_solution": "def merge_intervals(intervals):\n    covered = sorted([interval[:] for interval in intervals])\n    changed = True\n    while changed:\n        changed = False\n        result = []\n        for interval in covered:\n            if result and interval[0] <= result[-1][1]:\n                result[-1][1] = max(result[-1][1], interval[1])\n                changed = True\n            else:\n                result.append(interval)\n        covered = result\n    return covered\n",
  "known_wrong_solutions": [
    "def merge_intervals(intervals):\n    return None\n",
    "def merge_intervals(intervals):\n    return 0\n"
  ],
  "target_time_complexity": "O(n log n)",
  "target_space_complexity": "O(n)",
  "estimated_minutes": 25,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 0,
    "edge_cases": 0
  },
  "hints": [
    "Process intervals in starting-time order.",
    "Only the most recently merged interval can overlap the next one.",
    "Extend the last end when next.start <= last.end; otherwise append.",
    "Sorting dominates the running time."
  ],
  "editorial": "Sort by start, then either extend the last merged interval or begin a new one.",
