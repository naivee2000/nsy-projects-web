  "title": "Merge Overlapping Reservations",
  "summary": "Collapse overlapping closed intervals.",
  "statement": "Merge all overlapping closed intervals and return the non-overlapping result ordered by start.",
  "constraints": [
    "0 <= len(intervals) <= 20,000",
    "Each interval has start <= end."
  ],
