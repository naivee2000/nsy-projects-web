  "title": "Pair Sum Indices",
  "summary": "Find two positions whose values reach a target.",
  "statement": "Return the two distinct indices whose values add to `target`. Exactly one solution exists, and the smaller index must come first.",
  "constraints": [
    "2 <= len(nums) <= 10,000",
    "Exactly one valid pair exists."
  ],
  "topics": [
    "arrays",
    "hash-maps"
  ],
  "prerequisites": [],
  "signature": {
    "name": "pair_sum_indices",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "target",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[int]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def pair_sum_indices(nums: list[int], target: int) -> list[int]:\n    result = []\n    # Write your solution here. You can run this at any point.\n    return result\n\n# Working sample: Run examples to see this result while you build.\nsample_nums = [2, 7, 11, 15]\nsample_target = 9\nprint(\"Current result:\", pair_sum_indices(sample_nums, sample_target))\n",
  "reference_solution": "def pair_sum_indices(nums, target):\n    seen = {}\n    for index, value in enumerate(nums):\n        partner = target - value\n        if partner in seen:\n            return [seen[partner], index]\n        seen[value] = index\n    return []\n",
  "brute_force_solution": "def pair_sum_indices(nums, target):\n    for left in range(len(nums)):\n        for right in range(left + 1, len(nums)):\n            if nums[left] + nums[right] == target:\n                return [left, right]\n    return []\n",
  "known_wrong_solutions": [
    "def pair_sum_indices(nums, target):\n    return None\n",
    "def pair_sum_indices(nums, target):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(n)",
  "estimated_minutes": 15,
  "rubric": {
    "algorithmic_insight": 1,
    "prerequisites": 0,
    "implementation": 1,
    "performance_pressure": 0,
    "edge_cases": 0
  },
  "hints": [
    "Remember values you have already visited.",
    "For each number, ask whether its complement is already known.",
    "Store value → index, then return when target - value appears.",
    "The one-pass hash-map solution uses linear time and space."
  ],
  "editorial": "Scan once while mapping each value to its index. A complement found in the map identifies the earlier position immediately.",
