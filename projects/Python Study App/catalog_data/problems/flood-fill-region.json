  "starter_code": "def flood_fill_region(image: list[list[int]], start_row: int, start_col: int, new_color: int) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def flood_fill_region(image, start_row, start_col, new_color):\n    original = image[start_row][start_col]\n    if original == new_color: return image\n    def fill(row, col):\n        if not (0 <= row < len(image) and 0 <= col < len(image[0])) or image[row][col] != original: return\n        image[row][col] = new_color\n        fill(row + 1, col); fill(row - 1, col); fill(row, col + 1); fill(row, col - 1)\n    fill(start_row, start_col)\n    return image\n",
  "brute_force_solution": "def flood_fill_region(image, start_row, start_col, new_color):\n    original = image[start_row][start_col]\n    if original == new_color: return image\n    def fill(row, col):\n        if not (0 <= row < len(image) and 0 <= col < len(image[0])) or image[row][col] != original: return\n        image[row][col] = new_color\n        fill(row + 1, col); fill(row - 1, col); fill(row, col + 1); fill(row, col - 1)\n    fill(start_row, start_col)\n    return image\n",
  "known_wrong_solutions": [
    "def flood_fill_region(image, start_row, start_col, new_color):\n    return None\n",
    "def flood_fill_region(image, start_row, start_col, new_color):\n    return 0\n"
  ],
