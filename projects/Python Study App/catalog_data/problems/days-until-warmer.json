  "id": "days-until-warmer",
  "version": 1,
  "status": "approved",
  "title": "Next Warmer Day",
  "summary": "Measure the wait for a warmer reading.",
  "statement": "For every temperature, return how many later days pass before a strictly warmer temperature. Use 0 when none exists.",
  "constraints": [
    "0 <= len(temperatures) <= 100,000",
    "Temperatures are integers."
  ],
  "topics": [
    "stacks",
    "arrays"
  ],
  "prerequisites": [
    "stacks"
  ],
  "signature": {
    "name": "days_until_warmer",
    "parameters": [
      {
        "name": "temperatures",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[int]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def days_until_warmer(temperatures: list[int]) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def days_until_warmer(temperatures):\n    answer = [0] * len(temperatures)\n    stack = []\n    for index, temperature in enumerate(temperatures):\n        while stack and temperatures[stack[-1]] < temperature:\n            earlier = stack.pop()\n            answer[earlier] = index - earlier\n        stack.append(index)\n    return answer\n",
  "brute_force_solution": "def days_until_warmer(temperatures):\n    answer = []\n    for index, temperature in enumerate(temperatures):\n        wait = 0\n        for future in range(index + 1, len(temperatures)):\n            if temperatures[future] > temperature:\n                wait = future - index\n                break\n        answer.append(wait)\n    return answer\n",
  "known_wrong_solutions": [
    "def days_until_warmer(temperatures):\n    return None\n",
    "def days_until_warmer(temperatures):\n    return 0\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(n)",
  "estimated_minutes": 25,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "Unresolved days can wait in a stack.",
    "A warmer current day resolves earlier colder stack entries.",
    "Store indices in decreasing temperature order.",
    "Each index enters and leaves the monotonic stack at most once."
  ],
  "editorial": "Maintain indices whose next warmer day is unknown. A warmer value pops and resolves every smaller temperature on top.",
