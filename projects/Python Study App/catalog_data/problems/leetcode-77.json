        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[list[int]]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def choose_numbers(n: int, k: int) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def choose_numbers(n, k):\n    answer, path = [], []\n    def visit(start):\n        if len(path) == k:\n            answer.append(path.copy())\n            return\n        needed = k - len(path)\n        for value in range(start, n - needed + 2):\n            path.append(value)\n            visit(value + 1)\n            path.pop()\n    visit(1)\n    return answer\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def choose_numbers(n, k):\n    answer, path = [], []\n    def visit(start):\n        if len(path) == k:\n            answer.append(path)\n            return\n        needed = k - len(path)\n        for value in range(start, n - needed + 2):\n            path.append(value)\n            visit(value + 1)\n            path.pop()\n    visit(1)\n    return answer\n",
    "def choose_numbers(n, k):\n    answer, path = [], []\n    def visit(start):\n        if len(path) == k:\n            answer.append(path.copy())\n            return\n        needed = k - len(path)\n        for value in range(start, n - needed + 1):\n            path.append(value)\n            visit(value + 1)\n            path.pop()\n    visit(1)\n    return answer\n"
  ],
  "target_time_complexity": "O(k × C(n,k))",
  "target_space_complexity": "O(k) excluding output",
