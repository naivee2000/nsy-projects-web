  "version": 1,
  "status": "approved",
  "title": "Combinations",
  "summary": "Given the integers n and k, return all possible combinations of k numbers chosen from the range [1, n].",
  "statement": "Given the integers n and k, return all possible combinations of k numbers chosen from the range [1, n]. The order of the output does not matter.",
  "constraints": [
    "1 <= k <= n <= 20.",
    "Choose k different values from 1 through n. Return each combination once; ordering is ignored."
  ],
  "topics": [
    "recursion",
    "backtracking"
  ],
  "prerequisites": [],
  "signature": {
    "name": "choose_numbers",
    "parameters": [
      {
        "name": "n",
        "annotation": "int",
        "adapter": "raw",
