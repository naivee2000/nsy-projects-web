{
  "id": "leetcode-350",
  "version": 1,
  "status": "approved",
  "title": "Intersection of Two Arrays II",
  "summary": "Given two integer arrays, nums1 and nums2, return an array containing their intersection.",
  "statement": "Given two integer arrays, nums1 and nums2, return an array containing their intersection. Each element in the result should appear as many times as it appears in both arrays. The order of the elements in the result can be any order.",
  "constraints": [
    "1 <= len(nums1), len(nums2) <= 1000; 0 <= every element <= 1000.",
    "Include each value min(count in nums1, count in nums2) times. Output order does not matter."
  ],
  "topics": [
    "arrays",
    "hash-maps"
  ],
  "prerequisites": [],
  "signature": {
    "name": "multiset_intersection",
    "parameters": [
      {
        "name": "nums1",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "nums2",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[int]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def multiset_intersection(nums1: list[int], nums2: list[int]) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def multiset_intersection(nums1, nums2):\n    from collections import Counter\n    available = Counter(nums1)\n    result = []\n    for value in nums2:\n        if available[value] > 0:\n            result.append(value)\n            available[value] -= 1\n    return result\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def multiset_intersection(nums1, nums2):\n    return list(set(nums1) & set(nums2))\n",
    "def multiset_intersection(nums1, nums2):\n    from collections import Counter\n    available = Counter(nums1)\n    result = []\n    for value in nums2:\n        if available[value] > 0:\n            result.append(value)\n            pass\n    return result\n"
  ],
  "target_time_complexity": "O(n + m) expected",
  "target_space_complexity": "O(n + m)",
  "estimated_minutes": 20,
  "rubric": {
    "algorithmic_insight": 1,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 0,
    "edge_cases": 0
  },
  "hints": [
    "Every match consumes one occurrence from each input.",
    "Count the first input, then consume available counts while scanning the second.",
    "If count[value]>0: append value and decrement its count.",
    "Each append spends one remaining occurrence, yielding the minimum of the two frequencies."
  ],
  "editorial": "Store remaining frequencies from one input. A value in the other input contributes only when its remaining count is positive; decrement immediately after appending. This differs from the unique-intersection exercise. The independent oracle removes matched values from a copied list, without a frequency map.",
