  "version": 1,
  "status": "approved",
  "title": "3Sum Closest",
  "summary": "Given nums and target, choose three values at distinct indices whose sum is closest to target.",
  "statement": "Given nums and target, choose three values at distinct indices whose sum is closest to target. The selected values may be equal. Return the sum, not the chosen indices. Each input has a unique closest sum.",
  "constraints": [
    "3 <= len(nums) <= 500; -1000 <= nums[i] <= 1000; -10000 <= target <= 10000.",
    "Choose three distinct indices, not necessarily three different values. Return their sum, not their indices or distance from target.",
    "The closest sum is unique: two different sums cannot tie for the smallest absolute distance to target."
  ],
  "topics": [
    "arrays",
    "two-pointers",
    "sorting"
  ],
  "prerequisites": [],
  "signature": {
    "name": "three_sum_closest",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
