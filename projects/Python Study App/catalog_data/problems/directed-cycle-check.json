  "starter_code": "def directed_cycle_check(node_count: int, edges: list[list[int]]) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def directed_cycle_check(node_count, edges):\n    graph = [[] for _ in range(node_count)]\n    for start, end in edges: graph[start].append(end)\n    state = [0] * node_count\n    def visit(node):\n        if state[node] == 1: return True\n        if state[node] == 2: return False\n        state[node] = 1\n        if any(visit(neighbor) for neighbor in graph[node]): return True\n        state[node] = 2; return False\n    return any(visit(node) for node in range(node_count) if state[node] == 0)\n",
  "brute_force_solution": "def directed_cycle_check(node_count, edges):\n    graph = [[] for _ in range(node_count)]\n    for start, end in edges: graph[start].append(end)\n    state = [0] * node_count\n    def visit(node):\n        if state[node] == 1: return True\n        if state[node] == 2: return False\n        state[node] = 1\n        if any(visit(neighbor) for neighbor in graph[node]): return True\n        state[node] = 2; return False\n    return any(visit(node) for node in range(node_count) if state[node] == 0)\n",
  "known_wrong_solutions": [
