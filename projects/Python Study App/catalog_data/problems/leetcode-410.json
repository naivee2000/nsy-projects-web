{
  "id": "leetcode-410",
  "version": 1,
  "status": "approved",
  "title": "Split Array Largest Sum",
  "summary": "Given an integer array nums and an integer k, divide nums into k non-empty contiguous subarrays to minimize the maximum sum of any subarray.",
  "statement": "Given an integer array nums and an integer k, divide nums into k non-empty contiguous subarrays to minimize the maximum sum of any subarray. Return the minimized maximum sum.",
  "constraints": [
    "1 <= nums.length <= 1,000; 0 <= nums[i] <= 10^6.",
    "1 <= k <= min(50, nums.length). Use exactly k nonempty contiguous parts.",
    "Preserve input order. Return the smallest achievable largest part sum, not the cuts."
  ],
  "topics": [
    "arrays",
    "binary-search",
    "greedy"
  ],
  "prerequisites": [
    "binary-search",
    "greedy"
  ],
  "signature": {
    "name": "split_array_largest_sum",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      },
      {
        "name": "k",
        "annotation": "int",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "int",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def split_array_largest_sum(nums: list[int], k: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def split_array_largest_sum(nums, k):\n    low, high = max(nums), sum(nums)\n    while low < high:\n        capacity = (low+high)//2\n        groups, subtotal = 1, 0\n        for value in nums:\n            if subtotal+value > capacity:\n                groups += 1\n                subtotal = 0\n            subtotal += value\n        if groups <= k:\n            high = capacity\n        else:\n            low = capacity+1\n    return low\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def split_array_largest_sum(nums,k):\n    return max(max(nums),(sum(nums)+k-1)//k)\n",
    "def split_array_largest_sum(nums, k):\n    low, high = max(nums), sum(nums)\n    while low < high:\n        capacity = (low+high)//2\n        groups, subtotal = 1, 0\n        for value in nums:\n            if subtotal+value > capacity:\n                groups += 1\n                subtotal = 0\n            subtotal += value\n        if groups == k:\n            high = capacity\n        else:\n            low = capacity+1\n    return low\n"
  ],
  "target_time_complexity": "O(n log(sum(nums)+1))",
  "target_space_complexity": "O(1)",
  "estimated_minutes": 50,
  "rubric": {
    "algorithmic_insight": 3,
    "prerequisites": 2,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 1
  },
  "hints": [
    "Test whether a proposed maximum sum is feasible.",
    "Greedily fill each part until the next item would exceed that capacity.",
    "Binary-search max(nums)..sum(nums); at most k greedy groups means feasible, otherwise increase capacity.",
    "Nonnegative items make feasibility monotone and let you split existing groups to reach exactly k without increasing the largest sum."
  ],
  "editorial": "For fixed capacity, extending each part as far as possible minimizes required groups. If that minimum is at most k, subdivide groups until there are exactly k nonempty pieces: nonnegative items cannot increase any sum. Feasible capacities form an upper interval for binary search. Zeros require no exception. This is not arbitrary bin packing; parts must be contiguous.",
