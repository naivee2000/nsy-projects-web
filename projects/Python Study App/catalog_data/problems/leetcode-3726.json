{"id":"leetcode-3726","version":1,"status":"approved","title":"Remove Zeros in Decimal Representation","summary":"Given a positive integer n, return the integer formed by removing all zeros from its decimal representation.","statement":"Given a positive integer n, return the integer formed by removing all zeros from its decimal representation.","constraints":["Remove every zero digit from the positive integer’s decimal representation.","Keep all nonzero digits in their original order.","Return the resulting integer."],"topics":["math","strings"],"prerequisites":[],"signature":{"name":"remove_decimal_zeros","parameters":[{"name":"n","annotation":"int","adapter":"raw","source_parameter":null}],"returns":"int","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def remove_decimal_zeros(n: int) -> int:\n    # Write your solution here.\n    pass\n","reference_solution":"def remove_decimal_zeros(n):\n    return int(str(n).replace('0',''))\n","brute_force_solution":null,"known_wrong_solutions":["def remove_decimal_zeros(n):\n    return int(str(n).replace('0','1'))\n","def remove_decimal_zeros(n):\n    return int(str(n)[::-1].replace('0',''))\n"],"target_time_complexity":"O(digits)","target_space_complexity":"O(digits)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["Convert n to its decimal text.","Remove every zero character.","The positive-input guarantee leaves at least one nonzero digit.","Parsing the retained sequence produces the requested integer."],"editorial":"Parsing the retained sequence produces the requested integer.","tests":[{"id":"lc-3726-1","arguments":[1020030],"expected":123,"comparator":"exact","visible":true,"explanation":"Removing zeros leaves the digits 123.","expected_node_order":null},{"id":"lc-3726-2","arguments":[7],"expected":7,"comparator":"exact","visible":true,"ex