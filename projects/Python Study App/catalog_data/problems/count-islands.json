  "starter_code": "def count_islands(grid: list[list[str]]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def count_islands(grid):\n    if not grid:\n        return 0\n    rows, columns = len(grid), len(grid[0])\n    visited = set()\n\n    def visit(start_row, start_column):\n        queue = deque([(start_row, start_column)])\n        visited.add((start_row, start_column))\n        while queue:\n            row, column = queue.popleft()\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = row + dr, column + dc\n                if 0 <= nr < rows and 0 <= nc < columns and grid[nr][nc] == \"1\" and (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    queue.append((nr, nc))\n\n    islands = 0\n    for row in range(rows):\n        for column in range(columns):\n            if grid[row][column] == \"1\" and (row, column) not in visited:\n                islands += 1\n                visit(row, column)\n    return islands\n",
  "brute_force_solution": "def count_islands(grid):\n    if not grid:\n        return 0\n    rows, columns = len(grid), len(grid[0])\n    visited = set()\n\n    def visit(start_row, start_column):\n        queue = deque([(start_row, start_column)])\n        visited.add((start_row, start_column))\n        while queue:\n            row, column = queue.popleft()\n            for dr, dc in ((1, 0), (-1, 0), (0, 1), (0, -1)):\n                nr, nc = row + dr, column + dc\n                if 0 <= nr < rows and 0 <= nc < columns and grid[nr][nc] == \"1\" and (nr, nc) not in visited:\n                    visited.add((nr, nc))\n                    queue.append((nr, nc))\n\n    islands = 0\n    for row in range(rows):\n        for column in range(columns):\n            if grid[row][column] == \"1\" and (row, column) not in visited:\n                islands += 1\n                visit(row, column)\n    return islands\n",
