  "starter_code": "def remove_duplicate_letters(s: str) -> str:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def remove_duplicate_letters(s):\n    last = {letter: index for index, letter in enumerate(s)}\n    stack, used = [], set()\n    for index, letter in enumerate(s):\n        if letter in used:\n            continue\n        while stack and stack[-1] > letter and last[stack[-1]] > index:\n            used.remove(stack.pop())\n        stack.append(letter)\n        used.add(letter)\n    return \"\".join(stack)\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def remove_duplicate_letters(s):\n    return \"\".join(sorted(set(s)))\n",
    "def remove_duplicate_letters(s):\n    return \"\".join(dict.fromkeys(s))\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(a), a <= 26",
  "estimated_minutes": 35,
