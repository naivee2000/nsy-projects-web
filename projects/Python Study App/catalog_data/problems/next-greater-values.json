  "starter_code": "def next_greater_values(nums: list[int]) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def next_greater_values(nums):\n    answer = [-1] * len(nums); stack = []\n    for i, value in enumerate(nums):\n        while stack and nums[stack[-1]] < value: answer[stack.pop()] = value\n        stack.append(i)\n    return answer\n",
  "brute_force_solution": "def next_greater_values(nums):\n    answer = [-1] * len(nums); stack = []\n    for i, value in enumerate(nums):\n        while stack and nums[stack[-1]] < value: answer[stack.pop()] = value\n        stack.append(i)\n    return answer\n",
  "known_wrong_solutions": [
    "def next_greater_values(nums):\n    return None\n",
    "def next_greater_values(nums):\n    return 0\n"
  ],
