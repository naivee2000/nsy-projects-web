  "reference_solution": "def rotate_values_right(nums, k):\n    if not nums: return []\n    k %= len(nums)\n    return nums[-k:] + nums[:-k] if k else nums[:]\n",
  "brute_force_solution": "def rotate_values_right(nums, k):\n    if not nums: return []\n    k %= len(nums)\n    return nums[-k:] + nums[:-k] if k else nums[:]\n",
