{"id":"leetcode-3667","version":1,"status":"approved","title":"Sort Array By Absolute Value","summary":"Given an integer array, rearrange its elements in ascending order based on their absolute values.","statement":"Given an integer array, rearrange its elements in ascending order based on their absolute values. Return the modified array.","constraints":["Rearrange nums by nondecreasing absolute value.","Python’s stable ordering preserves source order when absolute values tie.","Return the sorted array."],"topics":["arrays","sorting"],"prerequisites":[],"signature":{"name":"sort_by_absolute_value","parameters":[{"name":"nums","annotation":"list[int]","adapter":"raw","source_parameter":null}],"returns":"list[int]","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def sort_by_absolute_value(nums: list[int]) -> list[int]:\n    # Write your solution here.\n    pass\n","reference_solution":"def sort_by_absolute_value(nums):\n    return sorted(nums,key=abs)\n","brute_force_solution":null,"known_wrong_solutions":["def sort_by_absolute_value(nums):\n    return sorted(nums,)\n","def sort_by_absolute_value(nums):\n    return sorted(nums,key=lambda x:-abs(x))\n"],"target_time_complexity":"O(n log n)","target_space_complexity":"O(n)","estimated_minutes":20,"rubric":{"algorithmic_insight":1,"prerequisites":1,"implementation":1,"performance_pressure":0,"edge_cases":0},"hints":["Use absolute value as the sorting key.","Nondecreasing key order gives the required arrangement.","A stable sort keeps original relative order on equal keys.","Return the newly ordered values."],"editorial":"Return the newly ordered values.","tests":[{"id":"lc-3667-1","arguments":[[3,-1,-4,1,5]],"expected":[-1,1,3,-4,5],"comparator":"exact","visible":true,"explanation":"Absolute values order the result as [-1,1,3,-4,5].","expected_node_order":null},{"id":"lc-3667-2","arguments":[[-2,2,-1,1]],"expected":[-1,1,-2,2],"comparator":"exact","visible":true,"explanation":"The tied signs retain their original order within each absolute value.","expected_node_order":null},{"id":"lc-3667-3","arguments":[[0]],"expected":[0],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-4","arguments":[[1,-1]],"expected":[1,-1],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-5","arguments":[[5,4,3]],"expected":[3,4,5],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-6","arguments":[[-5,-1,-3]],"expected":[-1,-3,-5],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-7","arguments":[[0,-2,2]],"expected":[0,-2,2],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-8","arguments":[[10,-10,1]],"expected":[1,10,-10],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-9","arguments":[[2,-3,1]],"expected":[1,2,-3],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-10","arguments":[[7,0,-7]],"expected":[0,7,-7],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-11","arguments":[[4,-2,-4,2]],"expected":[-2,2,4,-4],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-12","arguments":[[100,-1,50]],"expected":[-1,50,100],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-13","arguments":[[3,3,-3]],"expected":[3,3,-3],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null},{"id":"lc-3667-14","arguments":[[9,-8,7,-6]],"expected":[-6,7,-8,9],"comparator":"exact","visible":false,"explanation":null,"expected_node_order":null}],"variation_dimensions":[],"seed_problem_id":null,"prompt_version":null}
