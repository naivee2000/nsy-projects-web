  "reference_solution": "def longest_increasing_run(nums):\n    best = current = 0\n    for i, value in enumerate(nums):\n        current = current + 1 if i and value > nums[i - 1] else 1\n        best = max(best, current)\n    return best\n",
  "brute_force_solution": "def longest_increasing_run(nums):\n    best = current = 0\n    for i, value in enumerate(nums):\n        current = current + 1 if i and value > nums[i - 1] else 1\n        best = max(best, current)\n    return best\n",
