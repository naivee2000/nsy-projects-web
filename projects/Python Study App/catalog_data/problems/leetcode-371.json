  "starter_code": "def sum_without_arithmetic(a: int, b: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def sum_without_arithmetic(a, b):\n    mask = 0xffffffff\n    a,b = a & mask,b & mask\n    while b:\n        a,b = a ^ b,((a & b) << 1) & mask\n    return a if a < 0x80000000 else ~(a ^ mask)\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def sum_without_arithmetic(a,b):\n    return a ^ b",
    "def sum_without_arithmetic(a, b):\n    mask = 0xffffffff\n    a,b = a & mask,b & mask\n    while b:\n        a,b = a ^ b,((a & b) << 1) & mask\n    return a\n"
  ],
