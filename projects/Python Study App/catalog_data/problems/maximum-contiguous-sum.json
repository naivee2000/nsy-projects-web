  "reference_solution": "def maximum_contiguous_sum(nums):\n    if not nums: return 0\n    ending = best = nums[0]\n    for value in nums[1:]: ending = max(value, ending + value); best = max(best, ending)\n    return best\n",
  "brute_force_solution": "def maximum_contiguous_sum(nums):\n    if not nums: return 0\n    ending = best = nums[0]\n    for value in nums[1:]: ending = max(value, ending + value); best = max(best, ending)\n    return best\n",
