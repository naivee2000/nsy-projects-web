  "starter_code": "def pascal_row(row_index: int) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def pascal_row(row_index):\n    row = [1]\n    for size in range(1, row_index + 1):\n        row.append(1)\n        for col in range(size - 1, 0, -1):\n            row[col] += row[col - 1]\n    return row\n",
  "brute_force_solution": null,
