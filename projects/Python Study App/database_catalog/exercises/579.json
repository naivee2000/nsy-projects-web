{"id":579,"topic":"Window functions","sql":"WITH r AS (SELECT id,month,SUM(salary) OVER (PARTITION BY id ORDER BY month RANGE BETWEEN 2 PRECEDING AND CURRENT ROW) AS Salary,\nMAX(month) OVER (PARTITION BY id) last_month FROM Employee) SELECT id,month,Salary FROM r WHERE month<last_month ORDER BY id,month DESC","pandas":"parts = []\nfor ident,g in Employee.groupby('id'):\n    data = g.set_index('month').salary\n    for month in sorted(data.index, reverse=True)[1:]:\n        total = data.loc[(data.index >= month-2) & (data.index <= month)].sum()\n        parts.append((ident,month,total))\nreturn pd.DataFrame(parts,columns=['id','month','Salary'])","schema":{"Employee":[["id","INT"],["month","INT"],["salary","INT"]]},"cases":[{"tables":{"Employee":[[1,1,20],[2,1,20],[1,2,30],[2,2,30],[3,2,40],[1,3,40],[3,3,60],[1,4,60],[3,4,70],[1,7,90],[1,8,90]]},"parameters":{},"expected":{"columns":["id","month","Salary"],"rows":[[1,7,90.0],[1,4,130.0],[1,3,90.0],[1,2,50.0],[1,1,20.0],[2,1,20.0],[3,3,100.0],[3,2,40.0]]}},{"tables":{"Employee":[[2,11,7],[2,1,11],[2,10,11],[3,11,10],[3,8,8],[1,10,10],[3,9,11],[1,2,9],[1,12,8],[1,9,11],[2,4,6],[1,3,10],[3,2,6],[3,3,8],[2,9,10]]},"parameters":{},"expected":{"columns":["id","month","Salary"],"rows":[[1,10,21.0],[1,9,11.0],[1,3,19.0],[1,2,9.0],[2,10,21.0],[2,9,10.0],[2,4,6.0],[2,1,11.0],[3,9,19.0],[3,8,8.0],[3,3,14.0],[3,2,6.0]]}},{"tables":{"Employee":[[2,12,6],[2,10,9],[4,8,12],[4,12,10],[1,9,12],[1,10,11],[2,2,5],[4,6,11],[3,11,7],[2,1,12],[2,4,5],[3,3,11],[3,2,11],[4,5,8],[1,1,11],[3,6,7],[3,7,10],[4,11,5],[1,12,7],[1,8,12]]},"parameters":{},"expected":{"columns":["id","month","Salary"],"rows":[[1,10,35.0],[1,9,24.0],[1,8,12.0],[1,1,11.0],[2,10,9.0],[2,4,10.0],[2,2,17.0],[2,1,12.0],[3,7,17.0],[3,6,7.0],[3,3,22.0],[3,2,11.0],[4,11,5.0],[4,8,23.0],[4,6,19.0],[4,5,8.0]]}},{"tables":{"Employee":[[3,3,6],[1,6,6],[2,12,6],[3,11,6],[5,9,11],[2,5,9],[1,1,7],[3,7,7],[3,9,12],[4,2,11],[4,6,12],[1,2,12],[5,2,10],[5,10,7],[2,8,10],[2,1,12],[5,8,9