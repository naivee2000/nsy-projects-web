{"id":3061,"topic":"Window functions","sql":"WITH T AS ( SELECT *, MAX(height) OVER (ORDER BY id) AS l, MAX(height) OVER (ORDER BY id DESC) AS r FROM Heights ) SELECT SUM(LEAST(l, r) - height) AS total_trapped_water FROM T","pandas":"h=Heights.sort_values('id').height\nlevel=pd.concat([h.cummax(),h.iloc[::-1].cummax()],axis=1).min(axis=1)\nreturn pd.DataFrame({'total_trapped_water':[(level-h).sum()]})","schema":{"Heights":[["id","INT"],["height","INT"]]},"cases":[{"tables":{"Heights":[[1,0],[2,1],[3,0],[4,2],[5,1],[6,0],[7,1],[8,3],[9,2],[10,1],[11,2],[12,1]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[6.0]]}},{"tables":{"Heights":[[6,1],[1,4],[3,2],[7,4],[2,0],[4,0],[5,4]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[13.0]]}},{"tables":{"Heights":[[3,2],[5,4],[2,0],[8,2],[1,4],[7,2],[4,0],[6,1]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[11.0]]}},{"tables":{"Heights":[[7,1],[8,0],[3,2],[4,0],[2,0],[6,1],[5,4],[1,4],[9,0]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[10.0]]}},{"tables":{"Heights":[[7,2],[1,4],[9,5],[6,1],[3,2],[8,4],[5,4],[2,0],[10,2],[4,0]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[15.0]]}},{"tables":{"Heights":[[3,2],[7,0],[5,4],[4,0],[10,5],[8,3],[1,4],[9,3],[6,1],[11,4],[2,0]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[19.0]]}},{"tables":{"Heights":[[1,4],[6,1],[10,4],[3,2],[7,5],[9,4],[2,0],[8,4],[4,0],[12,4],[5,4],[11,2]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[15.0]]}},{"tables":{"Heights":[[4,0],[11,1],[2,0],[13,5],[10,3],[8,0],[9,1],[12,2],[7,1],[1,4],[6,1],[5,4],[3,2]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[29.0]]}},{"tables":{"Heights":[[5,4],[2,0],[12,2],[4,0],[1,4],[7,0],[6,1],[8,5],[14,5],[10,5],[3,2],[13,1],[9,2],[11,4]]},"parameters":{},"expected":{"columns":["total_trapped_water"],"rows":[[28.0]]}},{"t