{"id":1651,"topic":"Window functions","sql":"WITH RECURSIVE Months AS ( SELECT 1 AS month UNION ALL SELECT month + 1 FROM Months WHERE month < 12 ), Ride AS ( SELECT month, SUM(IFNULL(ride_distance, 0)) AS ride_distance, SUM(IFNULL(ride_duration, 0)) AS ride_duration FROM Months AS m LEFT JOIN Rides AS r ON month = MONTH(requested_at) AND YEAR(requested_at) = 2020 LEFT JOIN AcceptedRides AS a ON r.ride_id = a.ride_id GROUP BY month ) SELECT month, ROUND( AVG(ride_distance) OVER ( ORDER BY month ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING ), 2 ) AS average_ride_distance, ROUND( AVG(ride_duration) OVER ( ORDER BY month ROWS BETWEEN CURRENT ROW AND 2 FOLLOWING ), 2 ) AS average_ride_duration FROM Ride ORDER BY month LIMIT 10","pandas":"from decimal import Decimal, ROUND_HALF_UP\nmonths = range(1,13)\njoined = Rides.merge(AcceptedRides,on='ride_id')\nyear = joined.loc[joined.requested_at.dt.year.eq(2020)].copy()\nyear['month'] = year.requested_at.dt.month\nactive = [int((Drivers.join_date < pd.Timestamp(2020,m,1)+pd.offsets.MonthBegin(1)).sum()) for m in months]\ntotals=year.groupby('month')[['ride_distance','ride_duration']].sum().reindex(months,fill_value=0)\nrows=[(m,*totals.loc[m:m+2].mean().round(2).tolist()) for m in range(1,11)]\nreturn pd.DataFrame(rows,columns=['month','average_ride_distance','average_ride_duration'])","schema":{"Drivers":[["driver_id","INT"],["join_date","DATE"]],"Rides":[["ride_id","INT"],["user_id","INT"],["requested_at","DATE"]],"AcceptedRides":[["ride_id","INT"],["driver_id","INT"],["ride_distance","INT"],["ride_duration","INT"]]},"cases":[{"tables":{"Drivers":[[10,"2019-12-10"],[8,"2020-1-13"],[5,"2020-2-16"],[7,"2020-3-8"],[4,"2020-5-17"],[1,"2020-10-24"],[6,"2021-1-5"]],"Rides":[[6,75,"2019-12-9"],[1,54,"2020-2-9"],[10,63,"2020-3-4"],[19,39,"2020-4-6"],[3,41,"2020-6-3"],[13,52,"2020-6-22"],[7,69,"2020-7-16"],[17,70,"2020-8-25"],[20,81,"2020-11-2"],[5,57,"2020-11-9"],[2,42,"2020-12-9"],[11,68,"2021-1-11"],[15,32,"2021-1-17"],[12,11,"2021-1-