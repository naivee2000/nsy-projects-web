{"id":1225,"topic":"Dates","sql":"WITH T AS ( SELECT fail_date AS dt, 'failed' AS st FROM Failed WHERE YEAR(fail_date) = 2019 UNION ALL SELECT success_date AS dt, 'succeeded' AS st FROM Succeeded WHERE YEAR(success_date) = 2019 ) SELECT st AS period_state, MIN(dt) AS start_date, MAX(dt) AS end_date FROM ( SELECT *, SUBDATE( dt, RANK() OVER ( PARTITION BY st ORDER BY dt ) ) AS pt FROM T ) AS t GROUP BY 1, pt ORDER BY 2","pandas":"all_days = pd.concat([Failed.fail_date.rename('day').to_frame().assign(state='failed'),Succeeded.success_date.rename('day').to_frame().assign(state='succeeded')]).sort_values('day')\ndays = all_days.loc[all_days.day.dt.year.eq(2019)]\nruns = (days.state.ne(days.state.shift()) | days.day.diff().ne(pd.Timedelta(days=1))).cumsum()\nreturn days.groupby(runs).agg(period_state=('state','first'),start_date=('day','min'),end_date=('day','max')).reset_index(drop=True)","schema":{"Failed":[["fail_date","DATE"]],"Succeeded":[["success_date","DATE"]]},"cases":[{"tables":{"Failed":[["2018-12-28"],["2018-12-29"],["2019-01-04"],["2019-01-05"]],"Succeeded":[["2018-12-30"],["2018-12-31"],["2019-01-01"],["2019-01-02"],["2019-01-03"],["2019-01-06"]]},"parameters":{},"expected":{"columns":["period_state","start_date","end_date"],"rows":[["succeeded","2019-01-01","2019-01-03"],["failed","2019-01-04","2019-01-05"],["succeeded","2019-01-06","2019-01-06"]]}},{"tables":{"Failed":[["2019-01-06"],["2018-12-30"],["2019-01-02"],["2019-01-05"],["2018-12-29"]],"Succeeded":[["2019-01-01"],["2018-12-31"],["2019-01-07"],["2019-01-03"],["2019-01-04"],["2018-12-28"]]},"parameters":{},"expected":{"columns":["period_state","start_date","end_date"],"rows":[["succeeded","2019-01-01","2019-01-01"],["failed","2019-01-02","2019-01-02"],["succeeded","2019-01-03","2019-01-04"],["failed","2019-01-05","2019-01-06"],["succeeded","2019-01-07","2019-01-07"]]}},{"tables":{"Failed":[["2019-01-05"],["2019-01-06"],["2018-12-30"],["2018-12-29"],["2019-01-02"]],"Succeeded":[["2018-12-31"],["2019-