{"id":1907,"topic":"Aggregation","sql":"WITH S AS ( SELECT 'Low Salary' AS category UNION SELECT 'Average Salary' UNION SELECT 'High Salary' ), T AS ( SELECT CASE WHEN income < 20000 THEN \"Low Salary\" WHEN income > 50000 THEN 'High Salary' ELSE 'Average Salary' END AS category, COUNT(1) AS accounts_count FROM Accounts GROUP BY 1 ) SELECT category, IFNULL(accounts_count, 0) AS accounts_count FROM S LEFT JOIN T USING (category)","pandas":"v=Accounts.income\nreturn pd.DataFrame({'category':['Low Salary','Average Salary','High Salary'],'accounts_count':[v.lt(20000).sum(),v.between(20000,50000).sum(),v.gt(50000).sum()]})","schema":{"Accounts":[["account_id","INT"],["income","INT"]]},"cases":[{"tables":{"Accounts":[[3,108939],[2,12747],[8,87709],[6,91796]]},"parameters":{},"expected":{"columns":["category","accounts_count"],"rows":[["Low Salary",1],["Average Salary",0],["High Salary",3]]}},{"tables":{"Accounts":[[1,19999],[2,20000],[6,1000],[4,50001],[3,50000]]},"parameters":{},"expected":{"columns":["category","accounts_count"],"rows":[["Average Salary",2],["High Salary",1],["Low Salary",2]]}},{"tables":{"Accounts":[[7,1001],[4,50001],[2,20000],[6,1000],[3,50000],[1,19999]]},"parameters":{},"expected":{"columns":["category","accounts_count"],"rows":[["Average Salary",2],["High Salary",1],["Low Salary",3]]}},{"tables":{"Accounts":[[4,50001],[7,1001],[2,20000],[8,1002],[1,19999],[3,50000],[6,1000]]},"parameters":{},"expected":{"columns":["category","accounts_count"],"rows":[["Average Salary",2],["High Salary",1],["Low Salary",4]]}},{"tables":{"Accounts":[[7,1001],[3,50000],[9,1003],[2,20000],[4,50001],[1,19999],[6,1000],[8,1002]]},"parameters":{},"expected":{"columns":["category","accounts_count"],"rows":[["Average Salary",2],["High Salary",1],["Low Salary",5]]}},{"tables":{"Accounts":[[1,19999],[7,1001],[3,50000],[8,1002],[4,50001],[9,1003],[6,1000],[10,1004],[2,20000]]},"parameters":{},"expected":{"columns":["category","accounts_count"],"rows":[["Average Salary",2],["H