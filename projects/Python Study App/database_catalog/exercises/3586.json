{"id":3586,"topic":"Dates","sql":"WITH first_positive AS ( SELECT patient_id, MIN(test_date) AS first_positive_date FROM covid_tests WHERE result = 'Positive' GROUP BY patient_id ), first_negative_after_positive AS ( SELECT t.patient_id, MIN(t.test_date) AS first_negative_date FROM covid_tests t JOIN first_positive p ON t.patient_id = p.patient_id AND t.test_date > p.first_positive_date WHERE t.result = 'Negative' GROUP BY t.patient_id ) SELECT p.patient_id, p.patient_name, p.age, DATEDIFF(n.first_negative_date, f.first_positive_date) AS recovery_time FROM first_positive f JOIN first_negative_after_positive n ON f.patient_id = n.patient_id JOIN patients p ON p.patient_id = f.patient_id ORDER BY recovery_time ASC, patient_name ASC","pandas":"rows=[]\nfor u,g in covid_tests.groupby('patient_id'):\n    pos=g.loc[g.result.eq('Positive'),'test_date'].min()\n    neg=g.loc[g.result.eq('Negative') & g.test_date.gt(pos),'test_date'].min()\n    if pd.notna(neg): rows.append((u,(neg-pos).days))\nn=pd.DataFrame(rows,columns=['patient_id','recovery_time'])\nreturn patients.merge(n,on='patient_id').sort_values(['recovery_time','patient_name'])","schema":{"patients":[["patient_id","INT"],["patient_name","VARCHAR(512)"],["age","INT"]],"covid_tests":[["test_id","INT"],["patient_id","INT"],["test_date","DATE"],["result","VARCHAR(512)"]]},"cases":[{"tables":{"patients":[[1,"Alice Smith",28],[2,"Bob Johnson",35],[3,"Carol Davis",42],[4,"David Wilson",31],[5,"Emma Brown",29]],"covid_tests":[[1,1,"2023-01-15","Positive"],[2,1,"2023-01-25","Negative"],[3,2,"2023-02-01","Positive"],[4,2,"2023-02-05","Inconclusive"],[5,2,"2023-02-12","Negative"],[6,3,"2023-01-20","Negative"],[7,3,"2023-02-10","Positive"],[8,3,"2023-02-20","Negative"],[9,4,"2023-01-10","Positive"],[10,4,"2023-01-18","Positive"],[11,5,"2023-02-15","Negative"],[12,5,"2023-02-20","Negative"]]},"parameters":{},"expected":{"columns":["patient_id","patient_name","age","recovery_time"],"rows":[[1,"Alice Smith",28,10],[3,"Carol Davi