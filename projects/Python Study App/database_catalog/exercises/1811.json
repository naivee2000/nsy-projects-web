{"id":1811,"topic":"Window functions","sql":"WITH S AS ( SELECT contest_id, gold_medal AS user_id, 1 AS type FROM Contests UNION SELECT contest_id, silver_medal AS user_id, 2 AS type FROM Contests UNION SELECT contest_id, bronze_medal AS user_id, 3 AS type FROM Contests ), T AS ( SELECT user_id, ( contest_id - ROW_NUMBER() OVER ( PARTITION BY user_id ORDER BY contest_id ) ) AS diff FROM S ), P AS ( SELECT user_id FROM S WHERE type = 1 GROUP BY user_id HAVING COUNT(1) >= 3 UNION SELECT DISTINCT user_id FROM T GROUP BY user_id, diff HAVING COUNT(1) >= 3 ) SELECT name, mail FROM P AS p LEFT JOIN Users AS u ON p.user_id = u.user_id","pandas":"medals=Contests.melt(id_vars='contest_id',value_name='user_id')\ngold=Contests.gold_medal.value_counts()\nqualified=set(gold[gold.ge(3)].index)\nfor u,g in medals.groupby('user_id'):\n    ids=set(g.contest_id)\n    if any({n,n+1,n+2} <= ids for n in ids): qualified.add(u)\nreturn Users.loc[Users.user_id.isin(qualified),['name','mail']]","schema":{"Contests":[["contest_id","INT"],["gold_medal","INT"],["silver_medal","INT"],["bronze_medal","INT"]],"Users":[["user_id","INT"],["mail","VARCHAR(512)"],["name","VARCHAR(512)"]]},"cases":[{"tables":{"Contests":[[190,1,5,2],[191,2,3,5],[192,5,2,3],[193,1,3,5],[194,4,5,2],[195,4,2,1],[196,1,5,2]],"Users":[[1,"sarah@leetcode.com","Sarah"],[2,"bob@leetcode.com","Bob"],[3,"alice@leetcode.com","Alice"],[4,"hercy@leetcode.com","Hercy"],[5,"quarz@leetcode.com","Quarz"]]},"parameters":{},"expected":{"columns":["name","mail"],"rows":[["Sarah","sarah@leetcode.com"],["Bob","bob@leetcode.com"],["Alice","alice@leetcode.com"],["Quarz","quarz@leetcode.com"]]}},{"tables":{"Contests":[[197,3,5,4],[192,5,2,3],[193,1,3,5],[194,4,5,2],[190,1,5,2],[195,4,2,1],[191,2,3,5],[196,1,5,2]],"Users":[[3,"alice@leetcode.com","Alice"],[5,"quarz@leetcode.com","Quarz"],[2,"bob@leetcode.com","Bob"],[1,"sarah@leetcode.com","Sarah"],[4,"hercy@leetcode.com","Hercy"]]},"parameters":{},"expected":{"columns":["name","mail"],"rows"