{"id":2175,"topic":"Ranking","sql":"WITH P AS ( SELECT team_id, SUM(points_change) AS delta FROM PointsChange GROUP BY team_id ) SELECT team_id, name, CAST(RANK() OVER (ORDER BY points DESC, name) AS SIGNED) - CAST( RANK() OVER (ORDER BY (points + delta) DESC, name) AS SIGNED ) AS 'rank_diff' FROM TeamPoints JOIN P USING (team_id)","pandas":"a=TeamPoints.merge(PointsChange.groupby('team_id').points_change.sum(),on='team_id',how='left').fillna({'points_change':0})\nold=a.sort_values(['points','name'],ascending=[False,True]).team_id.tolist()\nnew=a.assign(points=a.points+a.points_change).sort_values(['points','name'],ascending=[False,True]).team_id.tolist()\nreturn a[['team_id','name']].assign(rank_diff=[old.index(u)-new.index(u) for u in a.team_id])","schema":{"TeamPoints":[["team_id","INT"],["name","VARCHAR(512)"],["points","INT"]],"PointsChange":[["team_id","INT"],["points_change","INT"]]},"cases":[{"tables":{"TeamPoints":[[3,"Algeria",1431],[1,"Senegal",2132],[2,"New Zealand",1402],[4,"Croatia",1817]],"PointsChange":[[3,399],[2,0],[4,13],[1,-22]]},"parameters":{},"expected":{"columns":["team_id","name","rank_diff"],"rows":[[1,"Senegal",0],[4,"Croatia",-1],[3,"Algeria",1],[2,"New Zealand",0]]}},{"tables":{"TeamPoints":[[4,"Delta",92],[2,"Beta",100],[3,"Cy",81],[1,"Alpha",100]],"PointsChange":[[3,30],[4,0],[2,-5],[1,-10]]},"parameters":{},"expected":{"columns":["team_id","name","rank_diff"],"rows":[[1,"Alpha",-3],[2,"Beta",0],[3,"Cy",3],[4,"Delta",0]]}},{"tables":{"TeamPoints":[[3,"Cy",82],[2,"Beta",100],[4,"Delta",92],[1,"Alpha",100]],"PointsChange":[[4,0],[3,30],[2,-5],[1,-10]]},"parameters":{},"expected":{"columns":["team_id","name","rank_diff"],"rows":[[1,"Alpha",-3],[2,"Beta",0],[3,"Cy",3],[4,"Delta",0]]}},{"tables":{"TeamPoints":[[3,"Cy",83],[1,"Alpha",100],[2,"Beta",100],[4,"Delta",92]],"PointsChange":[[2,-5],[1,-10],[3,30],[4,0]]},"parameters":{},"expected":{"columns":["team_id","name","rank_diff"],"rows":[[1,"Alpha",-3],[2,"Beta",0],[3,"Cy",3],[4,"Delta",0]