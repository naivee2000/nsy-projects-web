{"id":1285,"topic":"Window functions","sql":"WITH T AS ( SELECT log_id, SUM(delta) OVER (ORDER BY log_id) AS pid FROM ( SELECT log_id, IF((log_id - LAG(log_id) OVER (ORDER BY log_id)) = 1, 0, 1) AS delta FROM Logs ) AS t ) SELECT MIN(log_id) AS start_id, MAX(log_id) AS end_id FROM T GROUP BY pid","pandas":"v=Logs.log_id.sort_values().reset_index(drop=True)\nreturn v.groupby(v.diff().ne(1).fillna(True).cumsum()).agg(start_id='min',end_id='max').reset_index(drop=True)","schema":{"Logs":[["log_id","INT"]]},"cases":[{"tables":{"Logs":[[1],[2],[3],[7],[8],[10]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[7,8],[10,10]]}},{"tables":{"Logs":[[2],[9],[1],[8],[12],[6],[3]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,12]]}},{"tables":{"Logs":[[2],[1],[3],[8],[13],[6],[9],[12]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,13]]}},{"tables":{"Logs":[[6],[3],[2],[1],[14],[12],[9],[8],[13]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,14]]}},{"tables":{"Logs":[[16],[9],[2],[1],[13],[6],[12],[8],[3],[14]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,14],[16,16]]}},{"tables":{"Logs":[[2],[1],[8],[16],[3],[9],[12],[14],[6],[13],[17]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,14],[16,17]]}},{"tables":{"Logs":[[6],[1],[17],[9],[3],[14],[18],[13],[8],[16],[12],[2]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,14],[16,18]]}},{"tables":{"Logs":[[13],[6],[2],[14],[8],[16],[3],[17],[20],[12],[1],[9],[18]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],[12,14],[16,18],[20,20]]}},{"tables":{"Logs":[[14],[13],[2],[8],[17],[21],[3],[9],[16],[18],[1],[6],[12],[20]]},"parameters":{},"expected":{"columns":["start_id","end_id"],"rows":[[1,3],[6,6],[8,9],