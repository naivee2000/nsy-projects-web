{"id":3230,"topic":"Aggregation","sql":"WITH T AS ( SELECT * FROM Transactions JOIN Products USING (product_id) ), P AS ( SELECT customer_id, category, COUNT(1) cnt, MAX(transaction_date) max_date FROM T GROUP BY 1, 2 ), R AS ( SELECT customer_id, category, RANK() OVER ( PARTITION BY customer_id ORDER BY cnt DESC, max_date DESC ) rk FROM P ) SELECT t.customer_id, ROUND(SUM(amount), 2) total_amount, COUNT(1) transaction_count, COUNT(DISTINCT t.category) unique_categories, ROUND(AVG(amount), 2) avg_transaction_amount, r.category top_category, ROUND(COUNT(1) * 10 + SUM(amount) / 100, 2) loyalty_score FROM T t JOIN R r ON t.customer_id = r.customer_id AND r.rk = 1 GROUP BY 1 ORDER BY 7 DESC, 1","pandas":"a=Transactions.merge(Products,on='product_id')\nrows=[]\nfor u,g in a.groupby('customer_id'):\n    c=g.groupby('category').transaction_date.agg(['size','max']).sort_values(['size','max'],ascending=False)\n    total=g.amount.sum()\n    n=len(g)\n    rows.append((u,round(total,2),n,len(c),round(total/n,2),c.index[0],round(n*10+total/100,2)))\nreturn pd.DataFrame(rows,columns=['customer_id','total_amount','transaction_count','unique_categories','avg_transaction_amount','top_category','loyalty_score']).sort_values(['loyalty_score','customer_id'],ascending=[False,True])","schema":{"Transactions":[["transaction_id","INT"],["customer_id","INT"],["product_id","INT"],["transaction_date","DATE"],["amount","DECIMAL(22,6)"]],"Products":[["product_id","INT"],["category","VARCHAR(512)"],["price","DECIMAL(22,6)"]]},"cases":[{"tables":{"Transactions":[[1,101,1,"2023-01-01",100.0],[2,101,2,"2023-01-15",150.0],[3,102,1,"2023-01-01",100.0],[4,102,3,"2023-01-22",200.0],[5,101,3,"2023-02-10",200.0]],"Products":[[1,"A",100.0],[2,"B",150.0],[3,"C",200.0]]},"parameters":{},"expected":{"columns":["customer_id","total_amount","transaction_count","unique_categories","avg_transaction_amount","top_category","loyalty_score"],"rows":[[101,450.0,3,3,150.0,"C",34.5],[102,300.0,2,2,150.0,"C",23.0]]}},{"