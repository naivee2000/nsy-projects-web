{"id":1841,"topic":"Aggregation","sql":"WITH Scores AS ( SELECT home_team_id AS team_id, CASE WHEN home_team_goals > away_team_goals THEN 3 WHEN home_team_goals < away_team_goals THEN 0 ELSE 1 END AS score, home_team_goals AS goals, away_team_goals AS away_goals FROM Matches UNION ALL SELECT away_team_id AS team_id, CASE WHEN home_team_goals > away_team_goals THEN 0 WHEN home_team_goals < away_team_goals THEN 3 ELSE 1 END AS score, away_team_goals AS goals, home_team_goals AS away_goals FROM Matches ) SELECT team_name, COUNT(1) AS matches_played, SUM(score) AS points, SUM(goals) AS goal_for, SUM(away_goals) AS goal_against, (SUM(goals) - SUM(away_goals)) AS goal_diff FROM Scores AS s JOIN Teams AS t ON s.team_id = t.team_id GROUP BY s.team_id ORDER BY points DESC, goal_diff DESC, team_name","pandas":"home=Matches[['home_team_id','home_team_goals','away_team_goals']].set_axis(['team_id','gf','ga'],axis=1)\naway=Matches[['away_team_id','away_team_goals','home_team_goals']].set_axis(home.columns,axis=1)\na=pd.concat([home,away],ignore_index=True)\na['points']=3*a.gf.gt(a.ga).astype(int)+a.gf.eq(a.ga).astype(int)\ng=a.groupby('team_id').agg(matches_played=('gf','size'),points=('points','sum'),goal_for=('gf','sum'),goal_against=('ga','sum'))\ng['goal_diff']=g.goal_for-g.goal_against\nreturn Teams.merge(g,on='team_id').drop(columns='team_id').sort_values(['points','goal_diff','team_name'],ascending=[False,False,True])","schema":{"Teams":[["team_id","INT"],["team_name","VARCHAR(512)"]],"Matches":[["home_team_id","INT"],["away_team_id","INT"],["home_team_goals","INT"],["away_team_goals","INT"]]},"cases":[{"tables":{"Teams":[[1,"Ajax"],[4,"Dortmund"],[6,"Arsenal"]],"Matches":[[1,4,0,1],[1,6,3,3],[4,1,5,2],[6,1,0,0]]},"parameters":{},"expected":{"columns":["team_name","matches_played","points","goal_for","goal_against","goal_diff"],"rows":[["Dortmund",2,6.0,6.0,2.0,4.0],["Arsenal",2,2.0,3.0,3.0,0.0],["Ajax",4,2.0,5.0,9.0,-4.0]]}},{"tables":{"Teams":[[1,"A"],[2,"B"],[3,"C"]],"