{"id":3673,"topic":"Aggregation","sql":"SELECT session_id,user_id,TIMESTAMPDIFF(MINUTE,MIN(event_timestamp),MAX(event_timestamp)) session_duration_minutes,\nSUM(event_type='scroll') scroll_count FROM app_events GROUP BY session_id,user_id\nHAVING TIMESTAMPDIFF(SECOND,MIN(event_timestamp),MAX(event_timestamp))>1800 AND scroll_count>=5\nAND SUM(event_type='click')*5<scroll_count AND SUM(event_type='purchase')=0 ORDER BY scroll_count DESC,session_id","pandas":"rows=[]\nfor (sid,u),g in app_events.groupby(['session_id','user_id']):\n    secs=(g.event_timestamp.max()-g.event_timestamp.min()).total_seconds()\n    n=g.event_type.eq('scroll').sum()\n    if secs>1800 and n>=5 and 5*g.event_type.eq('click').sum()<n and not g.event_type.eq('purchase').any():\n        rows.append((sid,u,int(secs//60),n))\nreturn pd.DataFrame(rows,columns=['session_id','user_id','session_duration_minutes','scroll_count']).sort_values(['scroll_count','session_id'],ascending=[False,True])","schema":{"app_events":[["event_id","INT"],["user_id","INT"],["event_timestamp","DATETIME"],["event_type","VARCHAR(512)"],["session_id","VARCHAR(512)"],["event_value","INT"]]},"cases":[{"tables":{"app_events":[[1,201,"2024-03-01 10:00:00","app_open","S001",null],[2,201,"2024-03-01 10:05:00","scroll","S001",500],[3,201,"2024-03-01 10:10:00","scroll","S001",750],[4,201,"2024-03-01 10:15:00","scroll","S001",600],[5,201,"2024-03-01 10:20:00","scroll","S001",800],[6,201,"2024-03-01 10:25:00","scroll","S001",550],[7,201,"2024-03-01 10:30:00","scroll","S001",900],[8,201,"2024-03-01 10:35:00","app_close","S001",null],[9,202,"2024-03-01 11:00:00","app_open","S002",null],[10,202,"2024-03-01 11:02:00","click","S002",null],[11,202,"2024-03-01 11:05:00","scroll","S002",400],[12,202,"2024-03-01 11:08:00","click","S002",null],[13,202,"2024-03-01 11:10:00","scroll","S002",350],[14,202,"2024-03-01 11:15:00","purchase","S002",50],[15,202,"2024-03-01 11:20:00","app_close","S002",null],[16,203,"2024-03-01 12:00:00","app_open","S003