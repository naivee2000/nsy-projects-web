{"id":3089,"topic":"Window functions","sql":"WITH feb AS (SELECT * FROM Posts WHERE post_date BETWEEN '2024-02-01' AND '2024-02-28'), w AS (\nSELECT p.user_id,p.post_id,(SELECT COUNT(*) FROM feb q WHERE q.user_id=p.user_id AND q.post_date BETWEEN p.post_date AND DATE_ADD(p.post_date,INTERVAL 6 DAY)) n FROM feb p)\nSELECT user_id,MAX(n) max_7day_posts,COUNT(*)/4 avg_weekly_posts FROM w GROUP BY user_id HAVING max_7day_posts>=2*avg_weekly_posts ORDER BY user_id","pandas":"a=Posts.loc[Posts.post_date.between('2024-02-01','2024-02-28')]\nrows=[]\nfor u,g in a.groupby('user_id'):\n    peak=max(g.post_date.between(d,d+pd.Timedelta(days=6)).sum() for d in g.post_date.unique())\n    avg=len(g)/4\n    if peak>=2*avg: rows.append((u,peak,avg))\nreturn pd.DataFrame(rows,columns=['user_id','max_7day_posts','avg_weekly_posts']).sort_values('user_id')","schema":{"Posts":[["post_id","INT"],["user_id","INT"],["post_date","DATE"]]},"cases":[{"tables":{"Posts":[[1,1,"2024-02-27"],[2,5,"2024-02-06"],[3,3,"2024-02-25"],[4,3,"2024-02-14"],[5,3,"2024-02-06"],[6,2,"2024-02-25"]]},"parameters":{},"expected":{"columns":["user_id","max_7day_posts","avg_weekly_posts"],"rows":[[1,1,0.25],[2,1,0.25],[5,1,0.25]]}},{"tables":{"Posts":[[8,2,"2024-02-08"],[1,1,"2024-02-01"],[3,1,"2024-02-07"],[9,2,"2024-02-15"],[2,1,"2024-02-01"],[5,1,"2024-02-15"],[7,2,"2024-02-01"],[6,1,"2024-02-22"],[10,2,"2024-02-22"],[11,2,"2024-02-29"],[4,1,"2024-02-08"],[12,3,"2024-02-01"]]},"parameters":{},"expected":{"columns":["user_id","max_7day_posts","avg_weekly_posts"],"rows":[[1,3,1.5],[3,1,0.25]]}},{"tables":{"Posts":[[7,2,"2024-02-01"],[2,1,"2024-02-01"],[11,2,"2024-02-29"],[10,2,"2024-02-22"],[5,1,"2024-02-15"],[8,2,"2024-02-08"],[4,1,"2024-02-08"],[6,1,"2024-02-22"],[12,3,"2024-02-01"],[1,1,"2024-02-01"],[9,2,"2024-02-15"],[13,3,"2024-02-02"],[3,1,"2024-02-07"]]},"parameters":{},"expected":{"columns":["user_id","max_7day_posts","avg_weekly_posts"],"rows":[[1,3,1.5],[3,2,0.5]]}},{"tables":{"Posts":[[14,3,"2024-02-