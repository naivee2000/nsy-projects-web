{"id":1917,"topic":"Joins","sql":"WITH T AS ( SELECT user1_id, user2_id FROM Friendship UNION SELECT user2_id AS user1_id, user1_id AS user2_id FROM Friendship ) SELECT DISTINCT l1.user_id, l2.user_id AS recommended_id FROM Listens AS l1, Listens AS l2 WHERE l1.day = l2.day AND l1.song_id = l2.song_id AND l1.user_id != l2.user_id AND NOT EXISTS ( SELECT 1 FROM T AS t WHERE l1.user_id = t.user1_id AND l2.user_id = t.user2_id ) GROUP BY l1.day, l1.user_id, l2.user_id HAVING COUNT(DISTINCT l1.song_id) >= 3","pandas":"songs=Listens.drop_duplicates().groupby(['day','user_id']).song_id.agg(set)\nfrom itertools import combinations\npairs=set()\nfor _,group in songs.groupby(level='day'):\n    for (a,sa),(b,sb) in combinations(group.droplevel('day').items(),2):\n        if len(sa & sb)>=3: pairs.add(tuple(sorted((a,b))))\nfriends={tuple(sorted(row)) for row in Friendship.itertuples(index=False,name=None)}\nreturn pd.DataFrame([(u,f) for a,b in pairs-friends for u,f in [(a,b),(b,a)]],columns=['user_id','recommended_id'])","schema":{"Listens":[["user_id","INT"],["song_id","INT"],["day","DATE"]],"Friendship":[["user1_id","INT"],["user2_id","INT"]]},"cases":[{"tables":{"Listens":[[1,10,"2021-03-15"],[1,11,"2021-03-15"],[1,12,"2021-03-15"],[2,10,"2021-03-15"],[2,11,"2021-03-15"],[2,12,"2021-03-15"],[3,10,"2021-03-15"],[3,11,"2021-03-15"],[3,12,"2021-03-15"],[4,10,"2021-03-15"],[4,11,"2021-03-15"],[4,13,"2021-03-15"],[5,10,"2021-03-16"],[5,11,"2021-03-16"],[5,12,"2021-03-16"]],"Friendship":[[1,2]]},"parameters":{},"expected":{"columns":["user_id","recommended_id"],"rows":[[1,3],[2,3],[3,1],[3,2]]}},{"tables":{"Listens":[[4,1,"2020-01-01"],[3,2,"2020-01-01"],[1,2,"2020-01-01"],[4,2,"2020-01-01"],[5,1,"2020-01-01"],[2,1,"2020-01-01"],[3,1,"2020-01-01"],[4,1,"2020-01-01"],[4,3,"2020-01-02"],[4,2,"2020-01-02"],[1,1,"2020-01-01"],[2,2,"2020-01-01"],[2,3,"2020-01-01"],[3,3,"2020-01-01"],[1,3,"2020-01-01"]],"Friendship":[[3,4],[1,2]]},"parameters":{},"expected":{"columns":["user_id","rec