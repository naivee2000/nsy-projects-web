{"id":1892,"topic":"Joins","sql":"WITH f AS (SELECT user1_id u,user2_id friend FROM Friendship UNION ALL SELECT user2_id,user1_id FROM Friendship)\nSELECT f.u AS user_id,l.page_id,COUNT(DISTINCT f.friend) AS friends_likes FROM f JOIN Likes l ON l.user_id=f.friend\nWHERE NOT EXISTS(SELECT 1 FROM Likes m WHERE m.user_id=f.u AND m.page_id=l.page_id) GROUP BY f.u,l.page_id","pandas":"from collections import Counter\nowned=set(Likes.itertuples(index=False,name=None))\nedges=list(Friendship.itertuples(index=False,name=None))\nvotes=Counter((u,p) for a,b in edges for u,f in [(a,b),(b,a)] for v,p in owned if f==v and (u,p) not in owned)\nreturn pd.DataFrame([(u,p,c) for (u,p),c in votes.items()],columns=['user_id','page_id','friends_likes'])","schema":{"Friendship":[["user1_id","INT"],["user2_id","INT"]],"Likes":[["user_id","INT"],["page_id","INT"]]},"cases":[{"tables":{"Friendship":[[1,2],[1,3],[1,4],[2,3],[2,4],[2,5],[6,1]],"Likes":[[1,88],[2,23],[3,24],[4,56],[5,11],[6,33],[2,77],[3,77],[6,88]]},"parameters":{},"expected":{"columns":["user_id","page_id","friends_likes"],"rows":[[1,77,2],[1,23,1],[1,24,1],[1,56,1],[1,33,1],[2,24,1],[2,56,1],[2,11,1],[2,88,1],[3,88,1],[3,23,1],[4,88,1],[4,77,1],[4,23,1],[5,77,1],[5,23,1]]}},{"tables":{"Friendship":[[1,4],[2,5],[2,3],[3,4],[2,4],[1,10],[1,2],[1,5],[1,3]],"Likes":[[4,45],[1,45],[3,55],[10,90],[2,55]]},"parameters":{},"expected":{"columns":["user_id","page_id","friends_likes"],"rows":[[1,55,2],[1,90,1],[2,45,2],[3,45,2],[4,55,2],[5,45,1],[5,55,1],[10,45,1]]}},{"tables":{"Friendship":[[2,4],[2,5],[1,10],[3,4],[1,3],[1,5],[2,3],[1,4],[1,11],[1,2]],"Likes":[[3,55],[2,55],[1,45],[10,90],[4,45],[11,91]]},"parameters":{},"expected":{"columns":["user_id","page_id","friends_likes"],"rows":[[1,55,2],[1,90,1],[1,91,1],[2,45,2],[3,45,2],[4,55,2],[5,45,1],[5,55,1],[10,45,1],[11,45,1]]}},{"tables":{"Friendship":[[1,3],[1,5],[1,2],[2,4],[1,10],[3,4],[1,11],[1,4],[2,5],[2,3],[1,12]],"Likes":[[12,92],[11,91],[2,55],[1,45],[4,45],[10,90],[3,5