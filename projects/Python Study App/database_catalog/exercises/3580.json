{"id":3580,"topic":"Window functions","sql":"WITH recent AS ( SELECT employee_id, review_date, ROW_NUMBER() OVER ( PARTITION BY employee_id ORDER BY review_date DESC ) AS rn, ( LAG(rating) OVER ( PARTITION BY employee_id ORDER BY review_date DESC ) - rating ) AS delta FROM performance_reviews ) SELECT employee_id, name, SUM(delta) AS improvement_score FROM recent JOIN employees USING (employee_id) WHERE rn > 1 AND rn <= 3 GROUP BY 1 HAVING COUNT(*) = 2 AND MIN(delta) > 0 ORDER BY 3 DESC, 2","pandas":"names=employees.set_index('employee_id').name\nrows=[]\nfor u,g in performance_reviews.sort_values('review_date').groupby('employee_id'):\n    scores=g.rating.tolist()[-3:]\n    if len(scores)==3 and scores[0]<scores[1]<scores[2]:\n        rows.append((u,names[u],scores[2]-scores[0]))\nreturn pd.DataFrame(rows,columns=['employee_id','name','improvement_score']).sort_values(['improvement_score','name'],ascending=[False,True])","schema":{"employees":[["employee_id","INT"],["name","VARCHAR(512)"]],"performance_reviews":[["review_id","INT"],["employee_id","INT"],["review_date","DATE"],["rating","INT"]]},"cases":[{"tables":{"employees":[[1,"Alice Johnson"],[2,"Bob Smith"],[3,"Carol Davis"],[4,"David Wilson"],[5,"Emma Brown"]],"performance_reviews":[[1,1,"2023-01-15",2],[2,1,"2023-04-15",3],[3,1,"2023-07-15",4],[4,1,"2023-10-15",5],[5,2,"2023-02-01",3],[6,2,"2023-05-01",2],[7,2,"2023-08-01",4],[8,2,"2023-11-01",5],[9,3,"2023-03-10",1],[10,3,"2023-06-10",2],[11,3,"2023-09-10",3],[12,3,"2023-12-10",4],[13,4,"2023-01-20",4],[14,4,"2023-04-20",4],[15,4,"2023-07-20",4],[16,5,"2023-02-15",3],[17,5,"2023-05-15",2]]},"parameters":{},"expected":{"columns":["employee_id","name","improvement_score"],"rows":[[2,"Bob Smith",3.0],[1,"Alice Johnson",2.0],[3,"Carol Davis",2.0]]}},{"tables":{"employees":[[2,"E2"],[1,"E1"],[10,"E10"],[3,"E3"]],"performance_reviews":[[1,1,"2024-01-01",5],[7,2,"2024-01-03",2],[11,10,"2024-01-02",3],[2,1,"2024-01-02",1],[12,10,"2024-01-03",5],[6,2,"2024-01-02",2]