{"id":2494,"topic":"Window functions","sql":"WITH S AS ( SELECT hall_id, start_day, end_day, MAX(end_day) OVER ( PARTITION BY hall_id ORDER BY start_day ) AS cur_max_end_day FROM HallEvents ), T AS ( SELECT *, IF( start_day <= LAG(cur_max_end_day) OVER ( PARTITION BY hall_id ORDER BY start_day ), 0, 1 ) AS start FROM S ), P AS ( SELECT *, SUM(start) OVER ( PARTITION BY hall_id ORDER BY start_day ) AS gid FROM T ) SELECT hall_id, MIN(start_day) AS start_day, MAX(end_day) AS end_day FROM P GROUP BY hall_id, gid","pandas":"rows=[]\nfor hall,g in HallEvents.sort_values('start_day').groupby('hall_id'):\n    windows=[]\n    for a,b in g[['start_day','end_day']].itertuples(index=False,name=None):\n        if windows and a<=windows[-1][1]:\n            windows[-1]=(windows[-1][0],max(windows[-1][1],b))\n        else: windows.append((a,b))\n    rows.extend((hall,a,b) for a,b in windows)\nreturn pd.DataFrame(rows,columns=['hall_id','start_day','end_day'])","schema":{"HallEvents":[["hall_id","INT"],["start_day","DATE"],["end_day","DATE"]]},"cases":[{"tables":{"HallEvents":[[1,"2023-01-13","2023-01-14"],[1,"2023-01-14","2023-01-17"],[1,"2023-01-18","2023-01-25"],[2,"2022-12-09","2022-12-23"],[2,"2022-12-13","2022-12-17"],[3,"2022-12-01","2023-01-30"]]},"parameters":{},"expected":{"columns":["hall_id","start_day","end_day"],"rows":[[1,"2023-01-13","2023-01-17"],[1,"2023-01-18","2023-01-25"],[2,"2022-12-09","2022-12-23"],[3,"2022-12-01","2023-01-30"]]}},{"tables":{"HallEvents":[[2,"2023-01-03","2023-01-04"],[2,"2023-01-06","2023-01-07"],[1,"2023-01-02","2023-01-11"],[1,"2023-01-11","2023-01-13"],[1,"2023-01-03","2023-01-04"]]},"parameters":{},"expected":{"columns":["hall_id","start_day","end_day"],"rows":[[1,"2023-01-02","2023-01-13"],[2,"2023-01-03","2023-01-04"],[2,"2023-01-06","2023-01-07"]]}},{"tables":{"HallEvents":[[1,"2023-01-11","2023-01-13"],[1,"2023-01-03","2023-01-04"],[1,"2023-01-02","2023-01-11"],[2,"2023-01-06","2023-01-07"],[2,"2023-01-08","2023-01-09"],[2,"2023-01