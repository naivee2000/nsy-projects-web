{"id":3705,"topic":"Dates","sql":"SELECT customer_id, COUNT(1) total_orders, ROUND( SUM( TIME(order_timestamp) BETWEEN '11:00:00' AND '14:00:00' OR TIME(order_timestamp) BETWEEN '18:00:00' AND '21:00:00' ) / COUNT(1) * 100 ) peak_hour_percentage, ROUND(AVG(order_rating), 2) average_rating FROM restaurant_orders GROUP BY customer_id HAVING total_orders >= 3 AND 5 * SUM( TIME(order_timestamp) BETWEEN '11:00:00' AND '14:00:00' OR TIME(order_timestamp) BETWEEN '18:00:00' AND '21:00:00' ) >= 3 * COUNT(1) AND average_rating >= 4.0 AND SUM(order_rating IS NOT NULL) / total_orders >= 0.5 ORDER BY average_rating DESC, customer_id DESC","pandas":"from decimal import Decimal, ROUND_HALF_UP\nrows=[]\nfor u,g in restaurant_orders.groupby('customer_id'):\n    n=len(g)\n    ts=g.order_timestamp.dt.strftime('%H:%M:%S')\n    peak=(ts.between('11:00:00','14:00:00') | ts.between('18:00:00','21:00:00')).sum()\n    rates=g.order_rating.dropna()\n    if n>=3 and 5*peak>=3*n and len(rates)*2>=n and rates.mean()>=4:\n        pct=int((Decimal(int(peak))*100/n).quantize(Decimal('1'),rounding=ROUND_HALF_UP))\n        avg=float((sum(Decimal(str(x)) for x in rates)/len(rates)).quantize(Decimal('.01'),rounding=ROUND_HALF_UP))\n        rows.append((u,n,pct,avg))\nreturn pd.DataFrame(rows,columns=['customer_id','total_orders','peak_hour_percentage','average_rating']).sort_values(['average_rating','customer_id'],ascending=False)","schema":{"restaurant_orders":[["order_id","INT"],["customer_id","INT"],["order_timestamp","DATETIME"],["order_amount","DECIMAL(22,6)"],["payment_method","VARCHAR(512)"],["order_rating","INT"]]},"cases":[{"tables":{"restaurant_orders":[[1,101,"2024-03-01 12:30:00",25.5,"card",5],[2,101,"2024-03-02 19:15:00",32.0,"app",4],[3,101,"2024-03-03 13:45:00",28.75,"card",5],[4,101,"2024-03-04 20:30:00",41.0,"app",null],[5,102,"2024-03-01 11:30:00",18.5,"cash",4],[6,102,"2024-03-02 12:00:00",22.0,"card",3],[7,102,"2024-03-03 15:30:00",19.75,"cash",null],[8,103,"2024-03-01 19:00:00",