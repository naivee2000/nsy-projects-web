{"id":3140,"topic":"Window functions","sql":"WITH T AS ( SELECT *, seat_id - (RANK() OVER (ORDER BY seat_id)) AS gid FROM Cinema WHERE free = 1 ), P AS ( SELECT MIN(seat_id) AS first_seat_id, MAX(seat_id) AS last_seat_id, COUNT(1) AS consecutive_seats_len, RANK() OVER (ORDER BY COUNT(1) DESC) AS rk FROM T GROUP BY gid ) SELECT first_seat_id, last_seat_id, consecutive_seats_len FROM P WHERE rk = 1 ORDER BY 1","pandas":"s=Cinema.loc[Cinema.free.eq(1),'seat_id'].sort_values().reset_index(drop=True)\ng=s.groupby(s-pd.RangeIndex(len(s))).agg(first_seat_id='min',last_seat_id='max',consecutive_seats_len='size')\nreturn g[g.consecutive_seats_len.eq(g.consecutive_seats_len.max())].sort_values('first_seat_id').reset_index(drop=True)","schema":{"Cinema":[["seat_id","INT"],["free","BOOLEAN"]]},"cases":[{"tables":{"Cinema":[[1,1],[2,0],[3,1],[4,1],[5,1]]},"parameters":{},"expected":{"columns":["first_seat_id","last_seat_id","consecutive_seats_len"],"rows":[[3,5,3]]}},{"tables":{"Cinema":[[2,1],[1,1],[7,1],[6,1],[4,0],[5,1],[3,1],[10,0],[9,1],[8,0],[11,0]]},"parameters":{},"expected":{"columns":["first_seat_id","last_seat_id","consecutive_seats_len"],"rows":[[1,3,3],[5,7,3]]}},{"tables":{"Cinema":[[5,1],[12,1],[3,1],[1,1],[10,0],[11,0],[2,1],[6,1],[4,0],[7,1],[9,1],[8,0]]},"parameters":{},"expected":{"columns":["first_seat_id","last_seat_id","consecutive_seats_len"],"rows":[[1,3,3],[5,7,3]]}},{"tables":{"Cinema":[[4,0],[12,1],[8,0],[10,0],[3,1],[9,1],[6,1],[13,0],[2,1],[5,1],[7,1],[1,1],[11,0]]},"parameters":{},"expected":{"columns":["first_seat_id","last_seat_id","consecutive_seats_len"],"rows":[[1,3,3],[5,7,3]]}},{"tables":{"Cinema":[[6,1],[10,0],[13,0],[7,1],[3,1],[1,1],[4,0],[12,1],[11,0],[9,1],[5,1],[14,1],[8,0],[2,1]]},"parameters":{},"expected":{"columns":["first_seat_id","last_seat_id","consecutive_seats_len"],"rows":[[1,3,3],[5,7,3]]}},{"tables":{"Cinema":[[4,0],[2,1],[14,1],[15,0],[1,1],[3,1],[13,0],[9,1],[11,0],[10,0],[6,1],[7,1],[5,1],[12,1],[8,0]]},"parameters":{},"e