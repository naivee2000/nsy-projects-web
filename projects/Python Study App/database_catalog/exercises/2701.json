{"id":2701,"topic":"Window functions","sql":"WITH T AS ( SELECT t1.*, SUM( CASE WHEN t2.customer_id IS NULL THEN 1 ELSE 0 END ) OVER (ORDER BY customer_id, transaction_date) AS s FROM Transactions AS t1 LEFT JOIN Transactions AS t2 ON t1.customer_id = t2.customer_id AND t1.amount > t2.amount AND DATEDIFF(t1.transaction_date, t2.transaction_date) = 1 ) SELECT customer_id, MIN(transaction_date) AS consecutive_start, MAX(transaction_date) AS consecutive_end FROM T GROUP BY customer_id, s HAVING COUNT(1) >= 3 ORDER BY customer_id","pandas":"a=Transactions.sort_values(['customer_id','transaction_date']).copy()\ng=a.groupby('customer_id')\ncontinuation=g.transaction_date.diff().dt.days.eq(1) & g.amount.diff().gt(0).fillna(False)\na['grp']=(~continuation).cumsum()\nruns=a.groupby(['customer_id','grp']).transaction_date.agg(['min','max','size']).reset_index()\nreturn runs.loc[runs['size'].ge(3),['customer_id','min','max']].rename(columns={'min':'consecutive_start','max':'consecutive_end'}).sort_values('customer_id')","schema":{"Transactions":[["transaction_id","INT"],["customer_id","INT"],["transaction_date","DATE"],["amount","INT"]]},"cases":[{"tables":{"Transactions":[[1,101,"2023-05-01",100],[2,101,"2023-05-02",150],[3,101,"2023-05-03",200],[4,102,"2023-05-01",50],[5,102,"2023-05-03",100],[6,102,"2023-05-04",200],[7,105,"2023-05-01",100],[8,105,"2023-05-02",150],[9,105,"2023-05-03",200],[10,105,"2023-05-04",300],[11,105,"2023-05-12",250],[12,105,"2023-05-13",260],[13,105,"2023-05-14",270]]},"parameters":{},"expected":{"columns":["customer_id","consecutive_start","consecutive_end"],"rows":[[101,"2023-05-01","2023-05-03"],[105,"2023-05-01","2023-05-04"],[105,"2023-05-12","2023-05-14"]]}},{"tables":{"Transactions":[[7,2,"2023-01-03",7],[4,1,"2023-01-05",9],[10,3,"2023-01-01",1],[5,2,"2023-01-01",5],[3,1,"2023-01-03",7],[1,1,"2023-01-01",5],[2,1,"2023-01-02",6],[6,2,"2023-01-02",5]]},"parameters":{},"expected":{"columns":["customer_id","consecutive_start","consecutive_end"],