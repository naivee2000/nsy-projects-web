{"id":3521,"topic":"Joins","sql":"SELECT a.product_id product1_id,b.product_id product2_id,p.category product1_category,q.category product2_category,COUNT(DISTINCT a.user_id) customer_count\nFROM ProductPurchases a JOIN ProductPurchases b ON a.user_id=b.user_id AND a.product_id<b.product_id JOIN ProductInfo p ON p.product_id=a.product_id JOIN ProductInfo q ON q.product_id=b.product_id\nGROUP BY a.product_id,b.product_id,p.category,q.category HAVING customer_count>=3 ORDER BY customer_count DESC,product1_id,product2_id","pandas":"from collections import Counter\nfrom itertools import combinations\na=ProductPurchases.merge(ProductInfo,on='product_id')\ncounts=Counter()\nfor u,g in a.groupby('user_id'):\n    counts.update(combinations(sorted(set(g['product_id'])),2))\ncats=ProductInfo.set_index('product_id').category\nrows=[(a,b,cats[a],cats[b],n) for (a,b),n in counts.items() if n>=3]\nreturn pd.DataFrame(rows,columns=['product1_id','product2_id','product1_category','product2_category','customer_count']).sort_values(['customer_count','product1_id','product2_id'],ascending=[False,True,True])","schema":{"ProductPurchases":[["user_id","INT"],["product_id","INT"],["quantity","INT"]],"ProductInfo":[["product_id","INT"],["category","VARCHAR(512)"],["price","DECIMAL(22,6)"]]},"cases":[{"tables":{"ProductPurchases":[[1,101,2],[1,102,1],[1,103,3],[2,101,1],[2,102,5],[2,104,1],[3,101,2],[3,103,1],[3,105,4],[4,101,1],[4,102,1],[4,103,2],[4,104,3],[5,102,2],[5,104,1]],"ProductInfo":[[101,"Electronics",100.0],[102,"Books",20.0],[103,"Clothing",35.0],[104,"Kitchen",50.0],[105,"Sports",75.0]]},"parameters":{},"expected":{"columns":["product1_id","product2_id","product1_category","product2_category","customer_count"],"rows":[[101,102,"Electronics","Books",3],[101,103,"Electronics","Clothing",3],[102,104,"Books","Kitchen",3]]}},{"tables":{"ProductInfo":[[4,"Books",5],[2,"Food",6],[3,"Clothes",4],[1,"Clothes",5]],"ProductPurchases":[[2,2,1],[3,1,1],[3,2,1],[1,4,2],[2,1,1],[10,4,1],[1,3