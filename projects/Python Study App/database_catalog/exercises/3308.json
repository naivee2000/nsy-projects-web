{"id":3308,"topic":"Ranking","sql":"WITH T AS ( SELECT fuel_type, driver_id, ROUND(AVG(rating), 2) rating, SUM(distance) distance, MAX(accidents) accidents FROM Drivers JOIN Vehicles USING (driver_id) JOIN Trips USING (vehicle_id) GROUP BY fuel_type, driver_id ), P AS ( SELECT *, RANK() OVER ( PARTITION BY fuel_type ORDER BY rating DESC, distance DESC, accidents ) rk FROM T ) SELECT fuel_type, driver_id, rating, distance FROM P WHERE rk = 1 ORDER BY 1","pandas":"a=Trips.merge(Vehicles,on='vehicle_id').merge(Drivers,on='driver_id')\ng=a.groupby(['fuel_type','driver_id']).agg(rating=('rating','mean'),distance=('distance','sum'),accidents=('accidents','first')).reset_index()\ng['rating']=g.rating.round(2)\ng=g.sort_values(['fuel_type','rating','distance','accidents'],ascending=[True,False,False,True])\nreturn g.drop_duplicates('fuel_type')[['fuel_type','driver_id','rating','distance']]","schema":{"Drivers":[["driver_id","INT"],["name","VARCHAR(512)"],["age","INT"],["experience","INT"],["accidents","INT"]],"Vehicles":[["vehicle_id","INT"],["driver_id","INT"],["model","VARCHAR(512)"],["fuel_type","VARCHAR(512)"],["mileage","INT"]],"Trips":[["trip_id","INT"],["vehicle_id","INT"],["distance","INT"],["duration","INT"],["rating","INT"]]},"cases":[{"tables":{"Drivers":[[1,"Alice",34,10,1],[2,"Bob",45,20,3],[3,"Charlie",28,5,0]],"Vehicles":[[100,1,"Sedan","Gasoline",20000],[101,2,"SUV","Electric",30000],[102,3,"Coupe","Gasoline",15000]],"Trips":[[201,100,50,30,5],[202,100,30,20,4],[203,101,100,60,4],[204,101,80,50,5],[205,102,40,30,5],[206,102,60,40,5]]},"parameters":{},"expected":{"columns":["fuel_type","driver_id","rating","distance"],"rows":[["Electric",2,4.5,180.0],["Gasoline",3,5.0,100.0]]}},{"tables":{"Drivers":[[2,"B",35,10,1],[3,"C",40,15,0],[1,"A",30,6,0]],"Vehicles":[[11,1,"A","Gas",2000],[13,3,"B","EV",2000],[12,2,"A","Gas",2000]],"Trips":[[5,13,20,10,5],[3,13,10,8,3],[2,12,60,30,5],[1,11,40,20,5]]},"parameters":{},"expected":{"columns":["fuel_type","driver_id","rat