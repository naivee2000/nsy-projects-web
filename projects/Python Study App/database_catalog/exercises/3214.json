{"id":3214,"topic":"Dates","sql":"WITH T AS ( SELECT product_id, YEAR(transaction_date) year, SUM(spend) curr_year_spend FROM user_transactions GROUP BY 1, 2 ), S AS ( SELECT t1.year, t1.product_id, t1.curr_year_spend, t2.curr_year_spend prev_year_spend FROM T t1 LEFT JOIN T t2 ON t1.product_id = t2.product_id AND t1.year = t2.year + 1 ) SELECT *, ROUND((curr_year_spend - prev_year_spend) / prev_year_spend * 100, 2) yoy_rate FROM S ORDER BY 2, 1","pandas":"a=user_transactions.assign(year=user_transactions.transaction_date.dt.year)\ns=a.groupby(['year','product_id']).spend.sum().reset_index(name='curr_year_spend')\nprev=s.rename(columns={'curr_year_spend':'prev_year_spend'}).copy()\nprev['year']+=1\nout=s.merge(prev,how='left',on=['year','product_id'])\nout['yoy_rate']=((out.curr_year_spend-out.prev_year_spend)*100/out.prev_year_spend).round(2)\nreturn out.sort_values(['product_id','year'])","schema":{"user_transactions":[["transaction_id","INT"],["product_id","INT"],["spend","DECIMAL(22,6)"],["transaction_date","DATETIME"]]},"cases":[{"tables":{"user_transactions":[[1341,123424,1500.6,"2019-12-31 12:00:00"],[1423,123424,1000.2,"2020-12-31 12:00:00"],[1623,123424,1246.44,"2021-12-31 12:00:00"],[1322,123424,2145.32,"2022-12-31 12:00:00"]]},"parameters":{},"expected":{"columns":["year","product_id","curr_year_spend","prev_year_spend","yoy_rate"],"rows":[[2019,123424,1500.6,null,null],[2020,123424,1000.2,1500.6,-33.35],[2021,123424,1246.44,1000.2,24.62],[2022,123424,2145.32,1246.44,72.12]]}},{"tables":{"user_transactions":[[4,1,300,"2023-01-01"],[2,1,50,"2020-02-01"],[5,2,30,"2024-02-01"],[1,1,50,"2020-01-01"],[3,1,120,"2021-01-01"]]},"parameters":{},"expected":{"columns":["year","product_id","curr_year_spend","prev_year_spend","yoy_rate"],"rows":[[2020,1,100.0,null,null],[2021,1,120.0,100.0,20.0],[2023,1,300.0,null,null],[2024,2,30.0,null,null]]}},{"tables":{"user_transactions":[[6,2,31,"2024-02-02"],[3,1,120,"2021-01-01"],[1,1,50,"2020-01-01"],[5,2,30,"2024-02-01"],[4