{"id":1205,"topic":"Aggregation","sql":"WITH T AS ( SELECT * FROM Transactions UNION SELECT id, country, 'chargeback', amount, c.trans_date FROM Transactions AS t JOIN Chargebacks AS c ON t.id = c.trans_id ) SELECT DATE_FORMAT(trans_date, '%Y-%m') AS month, country, SUM(state = 'approved') AS approved_count, SUM(IF(state = 'approved', amount, 0)) AS approved_amount, SUM(state = 'chargeback') AS chargeback_count, SUM(IF(state = 'chargeback', amount, 0)) AS chargeback_amount FROM T GROUP BY 1, 2 HAVING approved_amount OR chargeback_amount","pandas":"approved = Transactions.loc[Transactions.state.eq('approved'),['country','trans_date','amount']].assign(ac=1,charge=0,cb=0)\ncharge = Chargebacks.merge(Transactions[['id','country','amount','trans_date']].rename(columns={'trans_date':'purchase_date'}),left_on='trans_id',right_on='id')\ncharge = charge.assign(ac=0,charge=charge.amount,cb=1,amount=0)\na = pd.concat([approved,charge])\na['month'] = a.trans_date.dt.strftime('%Y-%m')\nreturn a.groupby(['month','country'],dropna=False).agg(approved_count=('ac','sum'),approved_amount=('amount','sum'),chargeback_count=('cb','sum'),chargeback_amount=('charge','sum')).reset_index()","schema":{"Transactions":[["id","INT"],["country","VARCHAR(512)"],["state","VARCHAR(100)"],["amount","INT"],["trans_date","DATE"]],"Chargebacks":[["trans_id","INT"],["trans_date","DATE"]]},"cases":[{"tables":{"Transactions":[[101,"US","approved",1000,"2019-05-18"],[102,"US","declined",2000,"2019-05-19"],[103,"US","approved",3000,"2019-06-10"],[104,"US","declined",4000,"2019-06-13"],[105,"US","approved",5000,"2019-06-15"]],"Chargebacks":[[102,"2019-05-29"],[101,"2019-06-30"],[105,"2019-09-18"]]},"parameters":{},"expected":{"columns":["month","country","approved_count","approved_amount","chargeback_count","chargeback_amount"],"rows":[["2019-05","US",1.0,1000.0,1.0,2000.0],["2019-06","US",2.0,8000.0,1.0,1000.0],["2019-09","US",0.0,0.0,1.0,5000.0]]}},{"tables":{"Transactions":[[5,"US","declined",40,"2022-02-