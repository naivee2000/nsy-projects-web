{"id":1127,"topic":"Aggregation","sql":"WITH P AS ( SELECT DISTINCT spend_date, 'desktop' AS platform FROM Spending UNION SELECT DISTINCT spend_date, 'mobile' FROM Spending UNION SELECT DISTINCT spend_date, 'both' FROM Spending ), T AS ( SELECT user_id, spend_date, SUM(amount) AS amount, IF(COUNT(platform) = 1, platform, 'both') AS platform FROM Spending GROUP BY 1, 2 ) SELECT p.*, IFNULL(SUM(amount), 0) AS total_amount, COUNT(t.user_id) AS total_users FROM P AS p LEFT JOIN T AS t USING (spend_date, platform) GROUP BY 1, 2","pandas":"g = Spending.groupby(['spend_date','user_id'])\nusers = g.agg(amount=('amount','sum'), label=('platform',lambda s: 'both' if s.nunique()>1 else s.iloc[0])).reset_index()\ntotals = users.groupby(['spend_date','label']).agg(total_amount=('amount','sum'),total_users=('user_id','size'))\nidx = pd.MultiIndex.from_product([Spending.spend_date.unique(),['desktop','mobile','both']], names=['spend_date','platform'])\nreturn totals.reindex(idx,fill_value=0).reset_index()","schema":{"Spending":[["user_id","INT"],["spend_date","DATE"],["platform","VARCHAR(100)"],["amount","INT"]]},"cases":[{"tables":{"Spending":[[1,"2019-07-01","mobile",100],[1,"2019-07-01","desktop",100],[2,"2019-07-01","mobile",100],[2,"2019-07-02","mobile",100],[3,"2019-07-01","desktop",100],[3,"2019-07-02","desktop",100]]},"parameters":{},"expected":{"columns":["spend_date","platform","total_amount","total_users"],"rows":[["2019-07-01","desktop",100.0,1],["2019-07-01","mobile",100.0,1],["2019-07-01","both",200.0,1],["2019-07-02","desktop",100.0,1],["2019-07-02","mobile",100.0,1],["2019-07-02","both",0.0,0]]}},{"tables":{"Spending":[[1,"2024-01-01","desktop",20],[2,"2024-01-01","mobile",15],[1,"2024-01-01","mobile",10],[5,"2024-01-02","mobile",3]]},"parameters":{},"expected":{"columns":["spend_date","platform","total_amount","total_users"],"rows":[["2024-01-01","both",30.0,1],["2024-01-01","desktop",0.0,0],["2024-01-01","mobile",15.0,1],["2024-01-02","both",0.0,0],["2024-01-02",