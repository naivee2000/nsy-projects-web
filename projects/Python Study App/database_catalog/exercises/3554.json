{"id":3554,"topic":"Joins","sql":"WITH user_category AS ( SELECT DISTINCT user_id, category FROM ProductPurchases JOIN ProductInfo USING (product_id) ), pair_per_user AS ( SELECT a.user_id, a.category AS category1, b.category AS category2 FROM user_category AS a JOIN user_category AS b ON a.user_id = b.user_id AND a.category < b.category ) SELECT category1, category2, COUNT(DISTINCT user_id) AS customer_count FROM pair_per_user GROUP BY 1, 2 HAVING customer_count >= 3 ORDER BY 3 DESC, 1, 2","pandas":"from collections import Counter\nfrom itertools import combinations\na=ProductPurchases.merge(ProductInfo,on='product_id')\ncounts=Counter()\nfor u,g in a.groupby('user_id'):\n    counts.update(combinations(sorted(set(g['category'])),2))\nrows=[(a,b,n) for (a,b),n in counts.items() if n>=3]\nreturn pd.DataFrame(rows,columns=['category1','category2','customer_count']).sort_values(['customer_count','category1','category2'],ascending=[False,True,True])","schema":{"ProductPurchases":[["user_id","INT"],["product_id","INT"],["quantity","INT"]],"ProductInfo":[["product_id","INT"],["category","VARCHAR(512)"],["price","DECIMAL(22,6)"]]},"cases":[{"tables":{"ProductPurchases":[[1,101,2],[1,102,1],[1,201,3],[1,301,1],[2,101,1],[2,102,2],[2,103,1],[2,201,5],[3,101,2],[3,103,1],[3,301,4],[3,401,2],[4,101,1],[4,201,3],[4,301,1],[4,401,2],[5,102,2],[5,103,1],[5,201,2],[5,202,3]],"ProductInfo":[[101,"Electronics",100.0],[102,"Books",20.0],[103,"Books",35.0],[201,"Clothing",45.0],[202,"Clothing",60.0],[301,"Sports",75.0],[401,"Kitchen",50.0]]},"parameters":{},"expected":{"columns":["category1","category2","customer_count"],"rows":[["Books","Clothing",3],["Books","Electronics",3],["Clothing","Electronics",3],["Electronics","Sports",3]]}},{"tables":{"ProductInfo":[[3,"Clothes",4],[4,"Books",5],[1,"Clothes",5],[2,"Food",6]],"ProductPurchases":[[1,4,2],[2,3,1],[1,3,1],[1,1,1],[2,4,3],[2,2,1],[10,4,1],[1,2,1],[2,1,1],[3,1,1],[3,2,1],[3,3,1]]},"parameters":{},"expected":{"columns":["category1