IN EmployeeShifts t2 ON t1.employee_id = t2.employee_id AND t1.start_time < t2.start_time AND t1.end_time > t2.start_time GROUP BY 1 ) SELECT employee_id, MAX(concurrent_count) max_overlapping_shifts, IFNULL(AVG(total_overlap_duration), 0) total_overlap_duration FROM S LEFT JOIN U USING (employee_id) GROUP BY 1 ORDER BY 1"],"wrong_pandas":["from itertools import combinations\nrows=[]\nfor u,g in EmployeeShifts.groupby('employee_id'):\n    peak=min(((g.start_time<=s)&(g.end_time>s)).sum() for s in g.start_time)\n    overlap=sum(max(0,(min(a.end_time,b.end_time)-max(a.start_time,b.start_time)).total_seconds()/60) for a,b in combinations(g.itertuples(),2))\n    rows.append((u,peak,overlap))\nreturn pd.DataFrame(rows,columns=['employee_id','max_overlapping_shifts','total_overlap_duration'])","from itertools import combinations\nrows=[]\nfor u,g in EmployeeShifts.groupby('employee_id'):\n    peak=max(((g.start_time<=s)&(g.end_time>s)).sum() for s in g.start_time)\n    overlap=sum(max(0,(min(a.end_time,b.end_time)-max(a.start_time,b.start_time)).total_seconds()/3600) for a,b in combinations(g.itertuples(),2))\n    rows.append((u,peak,overlap))\nreturn pd.DataFrame(rows,columns=['employee_id','max_overlapping_shifts','total_overlap_duration'])"],"ordered":true,"date_columns":[]}
