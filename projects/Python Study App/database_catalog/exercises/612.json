{"id":612,"topic":"Aggregation","sql":"SELECT ROUND(MIN(SQRT(POW(a.x-b.x,2)+POW(a.y-b.y,2))),2) AS shortest FROM Point2D a CROSS JOIN Point2D b WHERE a.x<>b.x OR a.y<>b.y","pandas":"from itertools import combinations\nfrom math import hypot\npoints = list(Point2D[['x','y']].itertuples(index=False,name=None))\nreturn pd.DataFrame({'shortest':[round(min(hypot(x-u,y-v) for (x,y),(u,v) in combinations(points,2)),2)]})","schema":{"Point2D":[["x","INT"],["y","INT"]]},"cases":[{"tables":{"Point2D":[[-1,-1],[0,0],[-1,-2]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.0]]}},{"tables":{"Point2D":[[4,8],[0,0],[0,2],[3,2]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[2.0]]}},{"tables":{"Point2D":[[4,11],[3,2],[0,0],[5,10],[0,2]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.41]]}},{"tables":{"Point2D":[[5,10],[0,0],[3,2],[6,2],[0,2],[4,3]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.41]]}},{"tables":{"Point2D":[[6,2],[0,0],[0,2],[3,2],[7,4],[4,7],[5,2]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.0]]}},{"tables":{"Point2D":[[0,2],[5,10],[4,6],[0,0],[6,2],[8,9],[7,7],[3,2]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[2.0]]}},{"tables":{"Point2D":[[3,2],[7,5],[6,10],[9,5],[5,8],[4,2],[0,2],[0,0],[8,6]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.0]]}},{"tables":{"Point2D":[[10,11],[0,2],[3,2],[7,10],[4,7],[9,8],[0,0],[6,7],[8,11],[5,4]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.41]]}},{"tables":{"Point2D":[[11,9],[6,8],[9,4],[3,2],[8,9],[5,10],[10,3],[0,0],[4,8],[0,2],[7,9]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.0]]}},{"tables":{"Point2D":[[4,11],[7,10],[8,6],[6,9],[9,9],[3,2],[0,0],[0,2],[10,8],[5,4],[12,4],[11,3]]},"parameters":{},"expected":{"columns":["shortest"],"rows":[[1.41]]}},{"tables":{"Point2D":[[3,2],[13,7],[7,9],[0,0],[0,2],[6,4],[10,5],[11,6],[12,10],[8,7],[4,9],[5,5],[9,5]]},"parameters":{},"expect