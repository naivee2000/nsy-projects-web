{"id":3156,"topic":"Window functions","sql":"WITH T AS ( SELECT DISTINCT employee_id, start_time AS st FROM Tasks UNION DISTINCT SELECT DISTINCT employee_id, end_time AS st FROM Tasks ), P AS ( SELECT *, LEAD(st) OVER ( PARTITION BY employee_id ORDER BY st ) AS ed FROM T ), S AS ( SELECT P.*, COUNT(1) AS concurrent_count FROM P INNER JOIN Tasks USING (employee_id) WHERE P.st >= Tasks.start_time AND P.ed <= Tasks.end_time GROUP BY 1, 2, 3 ) SELECT employee_id, FLOOR(SUM(TIME_TO_SEC(TIMEDIFF(ed, st)) / 3600)) AS total_task_hours, MAX(concurrent_count) AS max_concurrent_tasks FROM S GROUP BY 1 ORDER BY 1","pandas":"from collections import Counter\nrows=[]\nfor u,g in Tasks.groupby('employee_id'):\n    events=Counter(g.start_time)\n    events.subtract(g.end_time)\n    active=peak=seconds=0\n    prev=None\n    for time in sorted(events):\n        if prev is not None and active: seconds+=(time-prev).total_seconds()\n        active+=events[time]\n        peak=max(peak,active)\n        prev=time\n    rows.append((u,int(seconds//3600),peak))\nreturn pd.DataFrame(rows,columns=['employee_id','total_task_hours','max_concurrent_tasks']).sort_values('employee_id')","schema":{"Tasks":[["task_id","INT"],["employee_id","INT"],["start_time","DATETIME"],["end_time","DATETIME"]]},"cases":[{"tables":{"Tasks":[[1,1001,"2023-05-01 08:00:00","2023-05-01 09:00:00"],[2,1001,"2023-05-01 08:30:00","2023-05-01 10:30:00"],[3,1001,"2023-05-01 11:00:00","2023-05-01 12:00:00"],[7,1001,"2023-05-01 13:00:00","2023-05-01 15:30:00"],[4,1002,"2023-05-01 09:00:00","2023-05-01 10:00:00"],[5,1002,"2023-05-01 09:30:00","2023-05-01 11:30:00"],[6,1003,"2023-05-01 14:00:00","2023-05-01 16:00:00"]]},"parameters":{},"expected":{"columns":["employee_id","total_task_hours","max_concurrent_tasks"],"rows":[[1001,6.0,2],[1002,2.0,2],[1003,2.0,1]]}},{"tables":{"Tasks":[[2,1,"2024-02-01 02:00:00","2024-02-01 04:00:00"],[3,1,"2024-02-01 04:00:00","2024-02-01 05:00:00"],[4,2,"2024-02-01 01:00:00","2024-02-01 01:30:00"],[