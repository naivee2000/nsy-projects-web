  "version": 1,
  "status": "approved",
  "title": "Combination Sum IV",
  "summary": "Given distinct positive integers nums and a positive target, count all ordered sequences of values from nums whose sum is target.",
  "statement": "Given distinct positive integers nums and a positive target, count all ordered sequences of values from nums whose sum is target. Values may be reused. Two sequences with the same values in a different order count separately. The answer fits a signed 32-bit integer.",
  "constraints": [
    "1 <= len(nums) <= 200; all values are distinct positive integers <= 1000; 1 <= target <= 1000.",
    "Values may be reused. ORDER MATTERS: [1,2] and [2,1] count separately. The final count is guaranteed to fit a signed 32-bit integer."
  ],
  "topics": [
    "arrays",
    "dynamic-programming",
    "recursion"
  ],
