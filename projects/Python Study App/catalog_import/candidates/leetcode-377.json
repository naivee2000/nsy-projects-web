  "starter_code": "def count_ordered_sums(nums: list[int], target: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def count_ordered_sums(nums, target):\n    ways = [1]+[0]*target\n    for total in range(1,target+1):\n        for value in nums:\n            if value <= total:\n                ways[total] += ways[total-value]\n    return ways[target]\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def count_ordered_sums(nums,target):\n    ways=[1]+[0]*target\n    for value in nums:\n        for total in range(value,target+1):\n            ways[total]+=ways[total-value]\n    return ways[target]",
    "def count_ordered_sums(nums,target):\n    ways=[1]+[0]*target\n    for value in nums:\n        for total in range(target,value-1,-1):\n            ways[total]+=ways[total-value]\n    return ways[target]"
  ],
  "target_time_complexity": "O(target * len(nums))",
  "target_space_complexity": "O(target)",
  "estimated_minutes": 35,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "Separate sequences according to their last value.",
    "For each total, sum the counts for total-value over every usable last value.",
    "Set ways[0]=1; loop totals upward, then choices; add ways[total-value] when value<=total.",
    "Each ordered sequence has one final value and one shorter prefix, so the recurrence counts it exactly once."
  ],
  "editorial": "Count by final choice, not by unordered sets of chosen values. Initializing the empty prefix count to one lets each exact first value contribute a sequence. Iterating totals before choices permits all orderings; looping choices first would instead count coin combinations. Positive values make the recurrence acyclic. The oracle explicitly enumerates all small sequences without memoization. This generalizes the original fixed one-or-two-step exercise to an input-dependent choice set.",
