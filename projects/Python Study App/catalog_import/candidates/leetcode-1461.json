{"id":"leetcode-1461","version":1,"status":"approved","title":"Check If a String Contains All Binary Codes of Size K","summary":"Determine if a binary string s includes every possible binary code of a specified length k as a substring.","statement":"Determine if a binary string s includes every possible binary code of a specified length k as a substring.","constraints":["Consider every contiguous substring of length k.","Return whether all 2^k binary strings occur."],"topics":["strings","sliding-window"],"prerequisites":[],"signature":{"name":"contains_all_binary_codes","parameters":[{"name":"s","annotation":"str","adapter":"raw","source_parameter":null},{"name":"k","annotation":"int","adapter":"raw","source_parameter":null}],"returns":"bool","return_adapter":"raw","node_policy":"values","result_mode":"return","mutated_parameter":null,"immutable_parameters":[]},"starter_code":"def contains_all_binary_codes(s: str, k: int) -> bool:\n    # Write your solution here.\n    pass\n","reference_solution":"def contains_all_binary_codes(s, k):\n return len({s[i:i+k] for i in range(len(s)-k+1)})==1<<k\n","brute_force_solution":null,"known_wrong_solutions":["def contains_all_binary_codes(s, k):\n return len({s[i:i+k] for i in range(len(s)-k+1)})==(1<<k)-1\n","def contains_all_binary_codes(s, k):\n return len({s[i:i+k-1] for i in range(len(s)-k+1)})==1<<k\n"],"target_time_complexity":"O(n*k)","target_space_complexity":"O(2^k*k)","estimated_minutes":35,"rubric":{"algorithmic_insight":2,"prerequisites":1,"implementation":1,"performance_pressure":1,"edge_cases":0},"hints":["Collect every length-k window in a set.","There are exactly 2^k possible binary strings.","Return whether the distinct-window count reaches that number.","No other length-k values exist, so reaching the domain size proves complete coverage."],"editorial":"No other length-k values exist, so reaching the domain size proves complete coverage.","tests":[{"id":"lc-1461-1","arguments":["00110110",2],"expected":true,"c