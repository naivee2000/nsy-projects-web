  "starter_code": "def add_digits(num: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def add_digits(num):\n    return 0 if num == 0 else 1 + (num - 1) % 9\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def add_digits(num):\n    return num % 9\n",
    "def add_digits(num):\n    return sum(map(int, str(num)))\n"
