    "def factor_combinations(n):\n    answers, path = [], []\n    def search(start, remaining):\n        divisor = start\n        while divisor * divisor <= remaining:\n            if remaining % divisor == 0:\n                path.append(divisor)\n                answers.append(path + [remaining // divisor])\n                search(2, remaining // divisor)\n                path.pop()\n            divisor += 1\n    search(2, n)\n    return answers\n"
