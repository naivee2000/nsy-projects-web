  "title": "Factor Combinations",
  "summary": "Given an integer n, find all combinations of its factors within the range [2, n-1].",
  "statement": "Given an integer n, find all combinations of its factors within the range [2, n-1]. Return the combinations in any order.",
  "constraints": [
    "1 ≤ n ≤ 10^7.",
    "Return each multiplicative factorization of n using factors from 2 through n-1 exactly once, in any order. A factor order is not a separate combination."
  ],
  "topics": [
    "backtracking",
    "recursion",
    "number-theory"
  ],
  "prerequisites": [],
