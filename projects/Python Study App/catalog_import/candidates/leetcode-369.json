{
  "id": "leetcode-369",
  "version": 1,
  "status": "approved",
  "title": "Plus One Linked List",
  "summary": "Given a non-negative integer represented by a linked list of digits, increment the integer by one.",
  "statement": "Given a non-negative integer represented by a linked list of digits, increment the integer by one.",
  "constraints": [
    "The linked list has 1 to 100 nodes. Node values are digits 0 through 9, most significant first.",
    "No leading zero is present unless the entire number is zero. Return a ListNode head representing the incremented number, not a Python list.",
    "Digits may be updated in place and an overflow head may be added. Reusing existing nodes is not required by this source contract."
  ],
  "topics": [
    "linked-lists",
    "math"
  ],
  "prerequisites": [],
  "signature": {
    "name": "plus_one_linked_list",
    "parameters": [
      {
        "name": "head",
        "annotation": "ListNode | None",
        "adapter": "listnode",
        "source_parameter": null
      }
    ],
    "returns": "ListNode | None",
    "return_adapter": "listnode",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "# Data structure supplied to this problem.\nclass ListNode:\n    def __init__(self, val: int = 0, next: \"ListNode | None\" = None):\n        self.val = val\n        self.next = next\n\n\ndef plus_one_linked_list(head: ListNode | None) -> ListNode | None:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def plus_one_linked_list(head):\n    dummy = ListNode(0,head)\n    last_non_nine = dummy\n    current = head\n    while current:\n        if current.val != 9:\n            last_non_nine = current\n        current = current.next\n    last_non_nine.val += 1\n    current = last_non_nine.next\n    while current:\n        current.val = 0\n        current = current.next\n    return dummy if dummy.val else dummy.next\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def plus_one_linked_list(head):\n    dummy = ListNode(0,head)\n    last_non_nine = dummy\n    current = head\n    while current:\n        if current.val != 9:\n            last_non_nine = current\n        current = current.next\n    last_non_nine.val += 1\n    current = last_non_nine.next\n    while current:\n        current.val = 0\n        current = current.next\n    return dummy.next\n",
    "def plus_one_linked_list(head):\n    current=head\n    while current.next:\n        current=current.next\n    current.val=(current.val+1)%10\n    return head"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(1) auxiliary",
  "estimated_minutes": 35,
  "rubric": {
    "algorithmic_insight": 2,
    "prerequisites": 1,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 0
  },
  "hints": [
    "Only the trailing run of 9s needs carry propagation.",
    "Keep the last node whose value is not 9, using a zero-valued dummy before the head.",
    "Increment that node, set every following digit to zero, and return the dummy only if it became 1.",
    "All digits after the remembered node are 9s; they become zeros. If every original digit is 9, the dummy provides the new leading 1."
  ],
  "editorial": "Track the rightmost non-9 digit in a forward traversal. Increment it and zero its suffix, which consists entirely of 9s. A leading dummy handles overflow without reversing links. The source requires a linked-node result but does not impose identity reuse. This is distinct from array Plus One because the function receives and returns actual ListNode objects. The independent oracle uses decimal arithmetic on the serialized digits.",
