  "title": "Predict the Winner",
  "summary": "Given an integer array, two players take turns choosing a number from either end to add to their score.",
  "statement": "Given an integer array, two players take turns choosing a number from either end to add to their score. Player 1 starts first. The game ends when the array is empty. Return true if Player 1 can win or tie the game, assuming both play optimally.",
  "constraints": [
    "1 <= nums.length <= 20; 0 <= nums[i] <= 10,000,000.",
    "Players alternate taking one value from either end, adding it to their own score. Both choose optimally.",
    "Return whether player 1 can finish with at least player 2's score. A tie counts as a win for player 1."
  ],
  "topics": [
    "arrays",
    "dynamic-programming",
    "recursion"
  ],
