  },
  "starter_code": "def predict_winner(nums: list[int]) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def predict_winner(nums):\n    from functools import cache\n    @cache\n    def margin(left,right):\n        if left==right:\n            return nums[left]\n        return max(nums[left]-margin(left+1,right),nums[right]-margin(left,right-1))\n    return margin(0,len(nums)-1)>=0\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def predict_winner(nums):\n    from functools import cache\n    @cache\n    def margin(left,right):\n        if left==right:\n            return nums[left]\n        return max(nums[left]-margin(left+1,right),nums[right]-margin(left,right-1))\n    return margin(0,len(nums)-1)>0\n",
    "def predict_winner(nums):\n    scores=[0,0]\n    left,right,turn=0,len(nums)-1,0\n    while left<=right:\n        if nums[left]>=nums[right]:\n            scores[turn]+=nums[left]\n            left+=1\n        else:\n            scores[turn]+=nums[right]\n            right-=1\n        turn^=1\n    return scores[0]>=scores[1]\n"
  ],
  "target_time_complexity": "O(n^2)",
  "target_space_complexity": "O(n^2)",
