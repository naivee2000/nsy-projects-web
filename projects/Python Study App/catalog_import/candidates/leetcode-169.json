  "starter_code": "def majority_element(nums: list[int]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def majority_element(nums):\n    candidate, votes = None, 0\n    for value in nums:\n        if votes == 0:\n            candidate = value\n        votes += 1 if value == candidate else -1\n    return candidate\n",
  "brute_force_solution": null,
