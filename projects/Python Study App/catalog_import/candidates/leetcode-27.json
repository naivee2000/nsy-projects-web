  "starter_code": "def remove_element(nums: list[int], val: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def remove_element(nums, val):\n    write = 0\n    for value in nums:\n        if value != val:\n            nums[write] = value\n            write += 1\n    return write\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def remove_element(nums, val):\n    write = 0\n    for value in nums:\n        if value == val:\n            nums[write] = value\n            write += 1\n    return write\n",
    "def remove_element(nums, val):\n    return sum(value != val for value in nums)\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(1)",
