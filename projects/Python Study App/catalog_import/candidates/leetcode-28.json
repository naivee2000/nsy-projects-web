  "starter_code": "def first_occurrence(haystack: str, needle: str) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def first_occurrence(haystack, needle):\n    prefix = [0] * len(needle)\n    matched = 0\n    for i in range(1, len(needle)):\n        while matched and needle[i] != needle[matched]:\n            matched = prefix[matched - 1]\n        if needle[i] == needle[matched]:\n            matched += 1\n        prefix[i] = matched\n    matched = 0\n    for i, char in enumerate(haystack):\n        while matched and char != needle[matched]:\n            matched = prefix[matched - 1]\n        if char == needle[matched]:\n            matched += 1\n        if matched == len(needle):\n            return i - len(needle) + 1\n    return -1\n",
  "brute_force_solution": null,
