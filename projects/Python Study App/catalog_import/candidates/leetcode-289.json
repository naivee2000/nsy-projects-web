{
  "id": "leetcode-289",
  "version": 1,
  "status": "approved",
  "title": "Game of Life",
  "summary": "The Game of Life, a cellular automaton created by John Horton Conway, evolves an m x n grid of cells, each initially live (1) or dead (0).",
  "statement": "The Game of Life, a cellular automaton created by John Horton Conway, evolves an m x n grid of cells, each initially live (1) or dead (0). Cells interact with their eight neighbors according to these rules: a live cell with fewer than two live neighbors dies; a live cell with two or three live neighbors survives; a live cell with more than three live neighbors dies; a dead cell with exactly three live neighbors becomes live. The board's next state is computed by applying these rules to all cells at once, updating births and deaths simultaneously. Given the current board state, update it to the next state.",
  "constraints": [
    "board is a rectangular 1–25 by 1–25 matrix containing only 0 and 1.",
    "Update every cell in place to the next Game of Life generation using all eight neighbors and the original generation simultaneously. Return nothing and use constant auxiliary space beyond local variables."
  ],
  "topics": [
    "matrices",
    "simulation",
    "in-place"
  ],
  "prerequisites": [],
  "signature": {
    "name": "game_of_life",
    "parameters": [
      {
        "name": "board",
        "annotation": "list[list[int]]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "None",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "mutated_argument",
    "mutated_parameter": 0,
    "immutable_parameters": []
  },
  "starter_code": "def game_of_life(board: list[list[int]]) -> None:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def game_of_life(board):\n    rows, columns = len(board), len(board[0])\n    for row in range(rows):\n        for column in range(columns):\n            live = sum(\n                board[other_row][other_column] in (1, 2)\n                for other_row in range(max(0, row - 1), min(rows, row + 2))\n                for other_column in range(max(0, column - 1), min(columns, column + 2))\n                if (other_row, other_column) != (row, column)\n            )\n            if board[row][column] == 1 and live not in (2, 3):\n                board[row][column] = 2\n            elif board[row][column] == 0 and live == 3:\n                board[row][column] = 3\n    for row in range(rows):\n        for column in range(columns):\n            board[row][column] %= 2\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def game_of_life(board):\n    rows, columns = len(board), len(board[0])\n    for row in range(rows):\n        for column in range(columns):\n            live = sum(\n                board[other_row][other_column] == 1\n                for other_row in range(max(0, row - 1), min(rows, row + 2))\n                for other_column in range(max(0, column - 1), min(columns, column + 2))\n                if (other_row, other_column) != (row, column)\n            )\n            if board[row][column] == 1 and live not in (2, 3):\n                board[row][column] = 2\n            elif board[row][column] == 0 and live == 3:\n                board[row][column] = 3\n    for row in range(rows):\n        for column in range(columns):\n            board[row][column] %= 2\n",
    "def game_of_life(board):\n    rows, columns = len(board), len(board[0])\n    for row in range(rows):\n        for column in range(columns):\n            live = sum(\n                board[other_row][other_column] in (1, 2)\n                for other_row, other_column in ((row-1,column),(row+1,column),(row,column-1),(row,column+1))\n                if 0 <= other_row < rows and 0 <= other_column < columns\n                if (other_row, other_column) != (row, column)\n            )\n            if board[row][column] == 1 and live not in (2, 3):\n                board[row][column] = 2\n            elif board[row][column] == 0 and live == 3:\n                board[row][column] = 3\n    for row in range(rows):\n        for column in range(columns):\n            board[row][column] %= 2\n"
  ],
  "target_time_complexity": "O(mn)",
  "target_space_complexity": "O(1)",
  "estimated_minutes": 35,
