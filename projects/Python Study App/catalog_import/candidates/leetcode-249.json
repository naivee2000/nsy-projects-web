  },
  "starter_code": "def group_shifted_strings(strings: list[str]) -> list[list[str]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def group_shifted_strings(strings):\n    groups = {}\n    for text in strings:\n        key = tuple((ord(text[index]) - ord(text[index - 1])) % 26\n                    for index in range(1, len(text)))\n        groups.setdefault(key, []).append(text)\n    return list(groups.values())\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def group_shifted_strings(strings):\n    groups = {}\n    for text in strings:\n        key = tuple((ord(text[index]) - ord(text[index - 1])) \n                    for index in range(1, len(text)))\n        groups.setdefault(key, []).append(text)\n    return list(groups.values())\n",
    "def group_shifted_strings(strings):\n    groups = {}\n    for text in strings: groups.setdefault(len(text), []).append(text)\n    return list(groups.values())\n"
  ],
  "target_time_complexity": "O(total input characters)",
  "target_space_complexity": "O(total input characters) including output",
