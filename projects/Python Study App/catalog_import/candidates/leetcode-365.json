  "starter_code": "def can_measure_water(x: int, y: int, target: int) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def can_measure_water(x, y, target):\n    from math import gcd\n    return target <= x+y and target % gcd(x,y) == 0\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
