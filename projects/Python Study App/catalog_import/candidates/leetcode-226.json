  "title": "Invert Binary Tree",
  "summary": "Given the root node of a binary tree, reverse the left and right child nodes for every node in the tree, then return the new root node.",
  "statement": "Given the root node of a binary tree, reverse the left and right child nodes for every node in the tree, then return the new root node.",
  "constraints": [
    "The tree has 0–100 nodes.",
    "-100 <= node.val <= 100.",
    "Input and output are displayed in level order; null denotes a missing child."
  ],
