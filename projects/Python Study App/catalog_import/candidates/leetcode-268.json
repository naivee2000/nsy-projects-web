  "starter_code": "def missing_number(nums: list[int]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def missing_number(nums):\n    n = len(nums)\n    return n * (n + 1) // 2 - sum(nums)\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def missing_number(nums):\n    n = len(nums)\n    return n * (n - 1) // 2 - sum(nums)\n",
    "def missing_number(nums):\n    n = len(nums)\n    return n * (n + 1) // 2 - sum(nums[:-1])\n"
  ],
  "target_time_complexity": "O(n)",
  "target_space_complexity": "O(1)",
  "estimated_minutes": 20,
