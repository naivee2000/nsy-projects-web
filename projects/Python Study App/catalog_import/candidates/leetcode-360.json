  "starter_code": "def sort_transformed_array(nums: list[int], a: int, b: int, c: int) -> list[int]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def sort_transformed_array(nums, a, b, c):\n    def transform(x):\n        return a*x*x+b*x+c\n    left, right = 0,len(nums)-1\n    result = [0]*len(nums)\n    for offset in range(len(nums)):\n        low, high = transform(nums[left]),transform(nums[right])\n        if a >= 0:\n            if low > high:\n                result[-1-offset] = low\n                left += 1\n            else:\n                result[-1-offset] = high\n                right -= 1\n        else:\n            if low < high:\n                result[offset] = low\n                left += 1\n            else:\n                result[offset] = high\n                right -= 1\n    return result\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def sort_transformed_array(nums, a, b, c):\n    return [a*x*x+b*x+c for x in nums]",
    "def sort_transformed_array(nums, a, b, c):\n    def transform(x):\n        return a*x*x+b*x+c\n    left, right = 0,len(nums)-1\n    result = [0]*len(nums)\n    for offset in range(len(nums)):\n        low, high = transform(nums[left]),transform(nums[right])\n        if True:\n            if low > high:\n                result[-1-offset] = low\n                left += 1\n            else:\n                result[-1-offset] = high\n                right -= 1\n        else:\n            if low < high:\n                result[offset] = low\n                left += 1\n            else:\n                result[offset] = high\n                right -= 1\n    return result\n"
  ],
