  "title": "Subsets II",
  "summary": "Given an integer array that may include duplicates, generate all unique subsets.",
  "statement": "Given an integer array that may include duplicates, generate all unique subsets. Ensure no subset is repeated in the output, and present the subsets in any order.",
  "constraints": [
    "1–10 integers, each in [-10,10]; duplicates are allowed.",
    "Each array occurrence is usable at most once. Return each distinct multiset subset once, ignoring order."
  ],
  "topics": [
    "arrays",
    "recursion",
    "backtracking"
  ],
  "prerequisites": [],
  "signature": {
    "name": "subsets_with_duplicates",
    "parameters": [
      {
        "name": "nums",
        "annotation": "list[int]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "list[list[int]]",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def subsets_with_duplicates(nums: list[int]) -> list[list[int]]:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def subsets_with_duplicates(nums):\n    values = sorted(nums)\n    answer, path = [], []\n    def visit(start):\n        answer.append(path.copy())\n        for i in range(start, len(values)):\n            if i > start and values[i] == values[i - 1]:\n                continue\n            path.append(values[i])\n            visit(i + 1)\n            path.pop()\n    visit(0)\n    return answer\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def subsets_with_duplicates(nums):\n    values = sorted(nums)\n    answer, path = [], []\n    def visit(start):\n        answer.append(path.copy())\n        for i in range(start, len(values)):\n            if False:\n                continue\n            path.append(values[i])\n            visit(i + 1)\n            path.pop()\n    visit(0)\n    return answer\n",
    "def subsets_with_duplicates(nums):\n    values = sorted(set(nums))\n    answer, path = [], []\n    def visit(start):\n        answer.append(path.copy())\n        for i in range(start, len(values)):\n            if i > start and values[i] == values[i - 1]:\n                continue\n            path.append(values[i])\n            visit(i + 1)\n            path.pop()\n    visit(0)\n    return answer\n"
  ],
