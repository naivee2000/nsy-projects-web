  "starter_code": "def is_power_of_three(n: int) -> bool:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def is_power_of_three(n):\n    if n <= 0:\n        return False\n    while n % 3 == 0:\n        n //= 3\n    return n == 1\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def is_power_of_three(n):\n    return n == 1 or (n > 0 and n % 3 == 0)\n",
    "def is_power_of_three(n):\n    if n <= 1:\n        return False\n    while n % 3 == 0:\n        n //= 3\n    return n == 1\n"
  ],
  "target_time_complexity": "O(log n) for positive n",
  "target_space_complexity": "O(1)",
