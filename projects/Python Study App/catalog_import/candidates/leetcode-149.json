{
  "id": "leetcode-149",
  "version": 1,
  "status": "approved",
  "title": "Max Points on a Line",
  "summary": "Provide an array of points on the X-Y plane, and determine the greatest count of points that align on a single straight line.",
  "statement": "Provide an array of points on the X-Y plane, and determine the greatest count of points that align on a single straight line.",
  "constraints": [
    "1 <= points.length <= 300; every point has exactly two integer coordinates.",
    "-10,000 <= x, y <= 10,000; all points are distinct.",
    "Vertical, horizontal, and negatively sloped lines all count. Return a count, not a line."
  ],
  "topics": [
    "geometry",
    "hash-maps",
    "arrays"
  ],
  "prerequisites": [
    "arrays",
    "hash-maps"
  ],
  "signature": {
    "name": "max_points_on_line",
    "parameters": [
      {
        "name": "points",
        "annotation": "list[list[int]]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "int",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null,
    "immutable_parameters": []
  },
  "starter_code": "def max_points_on_line(points: list[list[int]]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def max_points_on_line(points):\n    from math import gcd\n    best = 1\n    for i, (x, y) in enumerate(points):\n        counts = {}\n        for u, v in points[i+1:]:\n            dx, dy = u-x, v-y\n            divisor = gcd(abs(dx), abs(dy))\n            dx, dy = dx//divisor, dy//divisor\n            if dx < 0 or (dx == 0 and dy < 0):\n                dx, dy = -dx, -dy\n            key = (dx,dy)\n            counts[key] = counts.get(key,0)+1\n            best = max(best,counts[key]+1)\n    return best\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def max_points_on_line(points):\n    from math import gcd\n    best = 1\n    for i, (x, y) in enumerate(points):\n        counts = {}\n        for u, v in points[i+1:]:\n            dx, dy = u-x, v-y\n            divisor = 1\n            dx, dy = dx//divisor, dy//divisor\n            if dx < 0 or (dx == 0 and dy < 0):\n                dx, dy = -dx, -dy\n            key = (dx,dy)\n            counts[key] = counts.get(key,0)+1\n            best = max(best,counts[key]+1)\n    return best\n",
    "def max_points_on_line(points):\n    from math import gcd\n    best = 1\n    for i, (x, y) in enumerate(points):\n        counts = {}\n        for u, v in points[i+1:]:\n            dx, dy = u-x, v-y\n            if dx == 0:\n                continue\n            divisor = gcd(abs(dx), abs(dy))\n            dx, dy = dx//divisor, dy//divisor\n            if dx < 0 or (dx == 0 and dy < 0):\n                dx, dy = -dx, -dy\n            key = (dx,dy)\n            counts[key] = counts.get(key,0)+1\n            best = max(best,counts[key]+1)\n    return best\n"
  ],
  "target_time_complexity": "O(n² log C), C = coordinate span",
  "target_space_complexity": "O(n)",
  "estimated_minutes": 50,
  "rubric": {
    "algorithmic_insight": 3,
    "prerequisites": 2,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 1
  },
  "hints": [
    "Fix one point as an anchor and ask which other points share a line through it.",
    "Use an exact direction pair; reduce by the greatest common divisor and normalize its sign.",
    "For each anchor, count normalized (dx, dy) pairs to later points; the largest bucket plus one includes the anchor.",
    "The first input point on an optimal line sees all remaining points on that line. Integer direction keys avoid floating-point slope errors."
  ],
  "editorial": "For each anchor, reduce every displacement by gcd(|dx|, |dy|). Choose a consistent sign: dx positive, or dy positive when dx is zero. Opposite directions then share one key, and vertical lines need no division by zero. Add the anchor to the most frequent key. The earliest point on any optimal line sees every later point on that line. There are O(n²) pairs; gcd adds a logarithmic coordinate factor (bounded here), and the per-anchor map stores O(n) directions.",
