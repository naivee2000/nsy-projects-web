  "starter_code": "def minimum_perfect_squares(n: int) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def minimum_perfect_squares(n):\n    best = list(range(n + 1))\n    for value in range(1, n + 1):\n        root = 1\n        while root * root <= value:\n            best[value] = min(best[value], best[value - root * root] + 1)\n            root += 1\n    return best[n]\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
