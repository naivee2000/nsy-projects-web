{
  "id": "leetcode-265",
  "version": 1,
  "status": "approved",
  "title": "Paint House II",
  "summary": "Given an n x k cost matrix where each element costs[i][j] represents the cost to paint house i with color j, find the minimum cost to paint all houses such that no two adjacent houses have the same color.",
  "statement": "Given an n x k cost matrix where each element costs[i][j] represents the cost to paint house i with color j, find the minimum cost to paint all houses such that no two adjacent houses have the same color.",
  "constraints": [
    "costs is an n×k matrix with 1≤n≤100, 2≤k≤20, and costs[i][j] from 1 through 20.",
    "Choose one color column per house so adjacent houses use different colors. Return the minimum total cost in O(nk) time."
  ],
  "topics": [
    "arrays",
    "dynamic-programming"
  ],
  "prerequisites": [
    "dynamic-programming"
  ],
  "signature": {
    "name": "minimum_paint_cost_many_colors",
    "parameters": [
      {
        "name": "costs",
        "annotation": "list[list[int]]",
        "adapter": "raw",
        "source_parameter": null
      }
    ],
    "returns": "int",
    "return_adapter": "raw",
    "node_policy": "values",
    "result_mode": "return",
    "mutated_parameter": null
  },
  "starter_code": "def minimum_paint_cost_many_colors(costs: list[list[int]]) -> int:\n    # Write your solution here.\n    pass\n",
  "reference_solution": "def minimum_paint_cost_many_colors(costs):\n    previous = costs[0][:]\n    for row in costs[1:]:\n        least = second = float(\"inf\")\n        least_color = -1\n        for color, value in enumerate(previous):\n            if value < least:\n                second = least\n                least = value\n                least_color = color\n            elif value < second:\n                second = value\n        previous = [cost + (second if color == least_color else least)\n                    for color, cost in enumerate(row)]\n    return min(previous)\n",
  "brute_force_solution": null,
  "known_wrong_solutions": [
    "def minimum_paint_cost_many_colors(costs):\n    return sum(min(row) for row in costs)\n",
    "def minimum_paint_cost_many_colors(costs):\n    return min(sum(row[color] for row in costs) for color in range(len(costs[0])))\n"
  ],
  "target_time_complexity": "O(nk)",
  "target_space_complexity": "O(k)",
  "estimated_minutes": 50,
  "rubric": {
    "algorithmic_insight": 3,
    "prerequisites": 2,
    "implementation": 1,
    "performance_pressure": 1,
    "edge_cases": 1
  },
  "hints": [
    "The best prefix ending in color c needs the smallest previous cost from a different color.",
    "For each previous row, retain its smallest value, second-smallest value, and the smallest value's color.",
    "For current color c, add the second minimum only when c was the previous minimum's color; otherwise add the minimum.",
    "Compute the new row from the complete previous row. This avoids scanning all other colors for every cell."
  ],
  "editorial": "Dynamic programming stores the cheapest valid prefix ending in each color. The transition needs the minimum previous value excluding the current color. Knowing the smallest and second-smallest values makes that exclusion O(1), so all nk cells are processed once. The independent oracle enumerates all color assignments for small generated matrices; the source-scale fixture uses a direct O(nk²) exclusion DP.",
